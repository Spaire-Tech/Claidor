    "Allow Simeon to use a security key (such as a YubiKey) connected to your computer. You’ll be asked to approve each use." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Simeon, einen Sicherheitsschlüssel (z. B. einen YubiKey) an deinem Computer zu nutzen. Jede Nutzung musst du genehmigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que Simeon use una llave de seguridad (como una YubiKey) conectada a tu computadora. Se te pedirá aprobar cada uso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorise Simeon à utiliser une clé de sécurité (comme une YubiKey) branchée à ton ordinateur. Chaque utilisation te sera demandée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti a Simeon di usare una chiave di sicurezza (come una YubiKey) collegata al tuo computer. Ti verrà chiesto di approvare ogni utilizzo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta Simeon toe een beveiligingssleutel (zoals een YubiKey) te gebruiken die op je computer is aangesloten. Je wordt gevraagd elk gebruik goed te keuren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zezwól Simeonowi na używanie klucza bezpieczeństwa (np. YubiKey) podłączonego do twojego komputera. Każde użycie będzie wymagało twojego zatwierdzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita que o Simeon use uma chave de segurança (como uma YubiKey) conectada ao seu computador. Você precisará aprovar cada uso."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Låt Simeon använda en säkerhetsnyckel (till exempel en YubiKey) som är ansluten till din dator. Du får godkänna varje användning."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilgisayarına takılı bir güvenlik anahtarını (YubiKey gibi) Simeon’un kullanmasına izin ver. Her kullanımda onayın istenecek."
          }
        }
      }
    },
