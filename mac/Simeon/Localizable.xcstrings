    "Simeon can't use the microphone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simeon kann das Mikrofon nicht nutzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simeon no puede usar el micrófono."
          }
        },
        "fr" : {
          "stringUnit" : {
