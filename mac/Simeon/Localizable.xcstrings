    "Add a way to pay so your agents can make secure purchases for you. Each purchase waits for your approval." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge eine Zahlungsmethode hinzu, damit deine Agenten sicher für dich einkaufen können. Jeder Kauf wartet auf deine Genehmigung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrega un medio de pago para que tus agentes puedan hacer compras seguras por ti. Cada compra espera tu aprobación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute un moyen de paiement pour que tes agents puissent faire des achats sécurisés pour toi. Chaque achat attend ton accord."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi un metodo di pagamento così i tuoi agenti possono fare acquisti sicuri per te. Ogni acquisto attende la tua approvazione."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg een betaalmethode toe zodat je agenten veilig aankopen voor je kunnen doen. Elke aankoop wacht op je goedkeuring."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj metodę płatności, aby twoi agenci mogli bezpiecznie robić dla ciebie zakupy. Każdy zakup czeka na twoje zatwierdzenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione uma forma de pagamento para que seus agentes possam fazer compras seguras por você. Cada compra aguarda a sua aprovação."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till ett betalsätt så att dina agenter kan göra säkra köp åt dig. Varje köp väntar på ditt godkännande."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajanlarının senin için güvenli alışveriş yapabilmesi için bir ödeme yöntemi ekle. Her satın alma senin onayını bekler."
          }
        }
      }
    },
