    "Sign-in on this device is restricted by your organization's device policy. Sign in with an allowed account to continue." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anmeldung auf diesem Gerät ist durch die Geräterichtlinie deiner Organisation eingeschränkt. Melde dich mit einem erlaubten Account an, um fortzufahren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La política de dispositivos de tu organización restringe el inicio de sesión en este dispositivo. Inicia sesión con una cuenta permitida para continuar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion sur cet appareil est limitée par la politique de ton organisation. Connecte-toi avec un compte autorisé pour continuer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accesso su questo dispositivo è limitato dai criteri della tua organizzazione. Accedi con un account consentito per continuare."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inloggen op dit apparaat is beperkt door het apparaatbeleid van je organisatie. Log in met een toegestaan account om door te gaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logowanie na tym urządzeniu jest ograniczone przez zasady twojej organizacji. Zaloguj się dozwolonym kontem, aby kontynuować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A política de dispositivos da sua organização restringe o login neste dispositivo. Entre com uma conta permitida para continuar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inloggning på den här enheten begränsas av organisationens enhetspolicy. Logga in med ett tillåtet konto för att fortsätta."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu cihazda giriş, kuruluşunun cihaz politikasıyla kısıtlanmış. Devam etmek için izin verilen bir hesapla giriş yap."
          }
        }
      }
    },
