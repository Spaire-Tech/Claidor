    "Forgotten, each is asked about again the next time an agent needs it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergessene Befehle werden wieder abgefragt, sobald ein Agent sie das nächste Mal braucht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una vez olvidados, se te volverá a preguntar por cada uno la próxima vez que un agente lo necesite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fois oubliées, chacune te sera redemandée la prochaine fois qu’un agent en aura besoin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una volta dimenticati, ognuno ti verrà richiesto di nuovo la prossima volta che un agente ne avrà bisogno."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergeten opdrachten worden je opnieuw voorgelegd zodra een agent ze weer nodig heeft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapomniane polecenia znów będą wymagały twojej zgody, gdy agent będzie ich potrzebował."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois de esquecidos, você será perguntado de novo sobre cada um na próxima vez que um agente precisar dele."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glömda kommandon frågas om igen nästa gång en agent behöver dem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unutulan her komut, bir ajan ona yeniden ihtiyaç duyduğunda tekrar sorulur."
          }
        }
      }
    },
