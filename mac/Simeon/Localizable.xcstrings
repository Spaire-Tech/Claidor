    "Write one short, natural-language rule for each action. \"Ask first\" takes priority if rules conflict." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreib für jede Aktion eine kurze Regel in normaler Sprache. „Erst fragen“ hat Vorrang, wenn sich Regeln widersprechen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe una regla corta, en lenguaje natural, para cada acción. “Preguntar antes” tiene prioridad si hay reglas en conflicto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écris une règle courte, en langage naturel, pour chaque action. « Demander d’abord » l’emporte si des règles se contredisent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrivi una regola breve, in linguaggio naturale, per ogni azione. “Chiedi prima” ha la precedenza se le regole sono in conflitto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schrijf voor elke actie één korte regel in gewone taal. “Eerst vragen” gaat voor als regels botsen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napisz jedną krótką regułę w języku naturalnym dla każdej akcji. „Najpierw zapytaj” ma pierwszeństwo, gdy reguły są sprzeczne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escreva uma regra curta, em linguagem natural, para cada ação. “Perguntar antes” tem prioridade se as regras entrarem em conflito."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv en kort regel med vanliga ord för varje åtgärd. ”Fråga först” går före om regler krockar."
