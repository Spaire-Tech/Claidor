    "Simeon asks you before doing these. When two rules disagree, it asks." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simeon fragt dich, bevor es das tut. Widersprechen sich zwei Regeln, fragt es."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simeon te pregunta antes de hacer esto. Si dos reglas se contradicen, pregunta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simeon te demande avant de faire ces actions. Si deux règles se contredisent, il demande."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simeon ti chiede prima di farle. Se due regole sono in conflitto, chiede."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simeon vraagt het je voordat het dit doet. Spreken twee regels elkaar tegen, dan vraagt het."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simeon pyta cię, zanim to zrobi. Gdy dwie reguły są sprzeczne, pyta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Simeon pergunta a você antes de fazer isso. Se duas regras se contradizem, ele pergunta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simeon frågar dig innan det gör detta. Säger två regler emot varandra frågar det."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simeon bunları yapmadan önce sana sorar. İki kural çelişirse sorar."
          }
        }
      }
    },
    "Simeon call" : {
      "localizations" : {
