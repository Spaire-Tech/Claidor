    "Hidden Agents stay active and keep their history, they just don't show in the sidebar." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausgeblendete Agenten bleiben aktiv und behalten ihren Verlauf, sie erscheinen nur nicht in der Seitenleiste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los agentes ocultos siguen activos y conservan su historial; solo dejan de aparecer en la barra lateral."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les agents masqués restent actifs et gardent leur historique, ils n’apparaissent simplement plus dans la barre latérale."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli agenti nascosti restano attivi e conservano la loro cronologia, semplicemente non compaiono nella barra laterale."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verborgen agenten blijven actief en houden hun geschiedenis, ze staan alleen niet in de navigatiekolom."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukryci agenci pozostają aktywni i zachowują historię — po prostu nie widać ich na pasku bocznym."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os agentes ocultos continuam ativos e mantêm o histórico; só não aparecem na barra lateral."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dolda agenter är fortfarande aktiva och behåller sin historik, de visas bara inte i sidofältet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gizli ajanlar etkin kalır ve geçmişlerini korur; yalnızca kenar çubuğunda görünmezler."
          }
        }
      }
    },
