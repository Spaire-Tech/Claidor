      }
    },
    "Simeon can’t set up a computer for this account yet. Setup starts automatically once this account has access." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simeon kann für diesen Account noch keinen Computer einrichten. Die Einrichtung startet automatisch, sobald dieser Account Zugang hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simeon todavía no puede preparar una computadora para esta cuenta. La preparación empieza sola en cuanto esta cuenta tenga acceso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simeon ne peut pas encore préparer d’ordinateur pour ce compte. La préparation démarre toute seule dès que ce compte a accès."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simeon non può ancora preparare un computer per questo account. La configurazione parte da sola appena questo account avrà accesso."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simeon kan nog geen computer instellen voor dit account. Het instellen begint vanzelf zodra dit account toegang heeft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simeon nie może jeszcze przygotować komputera dla tego konta. Konfiguracja rozpocznie się automatycznie, gdy konto uzyska dostęp."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Simeon ainda não pode preparar um computador para esta conta. A preparação começa sozinha assim que esta conta tiver acesso."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simeon kan inte förbereda en dator för det här kontot än. Förberedelsen startar automatiskt när kontot har fått åtkomst."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simeon bu hesap için henüz bilgisayar hazırlayamıyor. Bu hesap erişim kazandığında kurulum kendiliğinden başlar."
          }
        }
      }
    },
    "Simeon checks each action before it runs and asks you first when needed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simeon prüft jede Aktion, bevor sie ausgeführt wird, und fragt dich bei Bedarf vorher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simeon revisa cada acción antes de ejecutarla y te pregunta antes cuando hace falta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simeon vérifie chaque action avant de la lancer et te demande d’abord quand il le faut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simeon controlla ogni azione prima di eseguirla e ti chiede prima quando serve."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simeon controleert elke actie voordat die wordt uitgevoerd en vraagt het je eerst als dat nodig is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simeon sprawdza każdą akcję przed jej wykonaniem i w razie potrzeby najpierw cię pyta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Simeon verifica cada ação antes de executá-la e pergunta a você antes, quando necessário."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simeon kontrollerar varje åtgärd innan den körs och frågar dig först när det behövs."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simeon her eylemi çalıştırmadan önce kontrol eder ve gerektiğinde önce sana sorar."
          }
        }
      }
