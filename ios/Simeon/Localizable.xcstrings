    "By continuing, you agree to our [Terms](%@) & [Privacy Policy](%@)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du fortfährst, stimmst du unseren [Nutzungsbedingungen](%@) und der [Datenschutzerklärung](%@) zu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al continuar, aceptas nuestros [Términos](%1$@) y nuestra [Política de privacidad](%2$@)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En continuant, tu acceptes nos [Conditions](%1$@) et notre [Politique de confidentialité](%2$@)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuando, accetti i nostri [Termini](%1$@) e l’[Informativa sulla privacy](%2$@)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Door verder te gaan, ga je akkoord met onze [voorwaarden](%@) en ons [privacybeleid](%@)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontynuując, akceptujesz nasz [Regulamin](%@) i [Politykę prywatności](%@)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao continuar, você concorda com nossos [Termos](%1$@) e nossa [Política de privacidade](%2$@)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genom att fortsätta godkänner du våra [villkor](%@) och vår [integritetspolicy](%@)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devam ederek [Koşullar](%@) ve [Gizlilik Politikası](%@) metinlerini kabul etmiş olursun."
          }
        }
      }
    },
    "By tapping “Continue”, you agree to our [Terms](%@) and have read our [Privacy Policy](%@)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du auf „Weiter“ tippst, stimmst du unseren [Nutzungsbedingungen](%1$@) zu und bestätigst, dass du unsere [Datenschutzerklärung](%2$@) gelesen hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al tocar «Continuar», aceptas nuestros [Términos](%1$@) y confirmas que has leído nuestra [Política de privacidad](%2$@)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En touchant « Continuer », tu acceptes nos [Conditions](%1$@) et confirmes avoir lu notre [Politique de confidentialité](%2$@)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toccando «Continua», accetti i nostri [Termini](%1$@) e confermi di aver letto l’[Informativa sulla privacy](%2$@)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Door op ‘Ga door’ te tikken, ga je akkoord met onze [voorwaarden](%1$@) en bevestig je dat je ons [privacybeleid](%2$@) hebt gelezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotykając „Kontynuuj”, akceptujesz nasz [Regulamin](%1$@) i potwierdzasz zapoznanie się z naszą [Polityką prywatności](%2$@)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao tocar em “Continuar”, você concorda com nossos [Termos](%1$@) e confirma que leu nossa [Política de privacidade](%2$@)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genom att trycka på ”Fortsätt” godkänner du våra [villkor](%1$@) och bekräftar att du har läst vår [integritetspolicy](%2$@)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Devam et” seçeneğine dokunarak [Koşullar](%1$@) metnini kabul etmiş ve [Gizlilik Politikası](%2$@) metnini okumuş olursun."
          }
        }
      }
    },
