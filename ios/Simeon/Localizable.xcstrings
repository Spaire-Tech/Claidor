{
  "sourceLanguage" : "en",
  "strings" : {
    " If it doesn’t come back on its own, recover it — your files and logins are kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Falls er nicht von selbst zurückkommt, stell ihn wieder her – deine Dateien und Anmeldungen bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Si no vuelve por sí sola, recupérala — tus archivos e inicios de sesión se conservan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " S’il ne revient pas tout seul, récupère-le — tes fichiers et tes connexions sont conservés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Se non torna da solo, recuperalo — i tuoi file e i tuoi accessi restano."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Als hij niet vanzelf terugkomt, herstel hem dan — je bestanden en logins blijven bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Jeśli nie wróci sam, przywróć go — twoje pliki i sesje logowania zostaną zachowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Se ele não voltar sozinho, recupere-o — seus arquivos e logins são mantidos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Om den inte kommer tillbaka av sig själv, återställ den – dina filer och inloggningar finns kvar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Kendiliğinden geri gelmezse kurtar — dosyaların ve oturumların korunur."
          }
        }
      }
    },
