          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simeon non può usare il microfono. Consentilo in Impostazioni."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simeon kan de microfoon niet gebruiken. Sta het toe in Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simeon nie może używać mikrofonu. Zezwól na to w Ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Simeon não pode usar o microfone. Permita em Ajustes."
          }
        },
        "sv" : {
          "stringUnit" : {
