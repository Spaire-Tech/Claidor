    "NSFaceIDUsageDescription" : {
      "comment" : "Privacy - Face ID Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simeon nutzt Face ID, um die App zu entsperren, damit nur du deine Agenten sehen kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Simeon uses Face ID to unlock the app, so only you can see your agents."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simeon usa Face ID para desbloquear la app, para que solo tú puedas ver a tus agentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simeon utilise Face ID pour déverrouiller l’app, pour que tes agents ne soient visibles que par toi."
