    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simeons Anrufe mit deinen Agenten sind reine Sprachanrufe und schalten nie die Kamera ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Simeon's calls with your agents are voice only and never turn on the camera."
          }
        },
