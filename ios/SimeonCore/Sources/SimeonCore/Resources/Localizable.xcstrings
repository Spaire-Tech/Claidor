    "%@ is installed, but their content can't be fetched until Simeon's computer can read the source repository." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está instalado, pero su contenido no se puede obtener hasta que la computadora de Simeon pueda leer el repositorio de origen."
          }
        },
        "fr" : {
          "stringUnit" : {
