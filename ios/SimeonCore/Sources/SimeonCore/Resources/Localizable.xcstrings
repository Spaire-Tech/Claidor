    "Your agents can ask {App} for a one-time card to pay for something you asked them to buy, and read the bank and card accounts you choose to share." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Agenten können bei {App} eine Einmalkarte anfordern, um etwas zu bezahlen, das sie für dich kaufen sollen, und die Bank- und Kartenkonten lesen, die du freigibst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus agentes pueden pedirle a {App} una tarjeta de un solo uso para pagar algo que les pediste comprar, y leer las cuentas bancarias y tarjetas que elijas compartir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes agents peuvent demander à {App} une carte à usage unique pour payer ce que tu leur as demandé d’acheter, et lire les comptes bancaires et cartes que tu choisis de partager."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi agenti possono chiedere a {App} una carta monouso per pagare ciò che hai chiesto loro di acquistare, e leggere i conti bancari e le carte che scegli di condividere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je agenten kunnen {App} om een eenmalige kaart vragen om te betalen voor iets wat je ze hebt gevraagd te kopen, en de bank- en kaartrekeningen lezen die je kiest te delen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
