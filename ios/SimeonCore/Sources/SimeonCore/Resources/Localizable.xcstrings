    "An agent is working right now. Waiting lets its current turn finish. Updating now recreates the computer and interrupts it. Files and logins are kept either way." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un agente está trabajando en este momento. Si esperas, termina su turno actual. Si actualizas ahora, se vuelve a crear la computadora y se interrumpe. Los archivos y las sesiones iniciadas se conservan en ambos casos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un agent travaille en ce moment. Attendre lui laisse finir son tour en cours. Mettre à jour maintenant recrée l’ordinateur et l’interrompt. Les fichiers et les connexions sont conservés dans les deux cas."
          }
        }
      }
    },
