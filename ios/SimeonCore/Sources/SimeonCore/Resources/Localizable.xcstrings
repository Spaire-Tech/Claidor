    "A drawing your agents share gets a link on excalidraw.com that anyone with the link can open." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Zeichnung, die deine Agenten teilen, bekommt einen Link auf excalidraw.com, den jeder mit dem Link öffnen kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un dibujo que comparten tus agentes recibe un enlace en excalidraw.com que cualquiera con el enlace puede abrir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un dessin partagé par tes agents reçoit un lien sur excalidraw.com que toute personne disposant du lien peut ouvrir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un disegno condiviso dai tuoi agenti riceve un link su excalidraw.com che chiunque abbia il link può aprire."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een tekening die je agenten delen, krijgt een link op excalidraw.com die iedereen met de link kan openen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rysunek udostępniony przez twoich agentów dostaje link w excalidraw.com, który może otworzyć każdy, kto go ma."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um desenho que seus agentes compartilham ganha um link no excalidraw.com que qualquer pessoa com o link pode abrir."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
