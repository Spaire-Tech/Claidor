        }
      }
    },
    "You'll approve the connection on link.com or in the {App} app; your cloud computer keeps it. Simeon never sees your password or your card numbers." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprobarás la conexión en link.com o en la app {App}; tu computadora en la nube la guarda. Simeon nunca ve tu contraseña ni los números de tus tarjetas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu approuveras la connexion sur link.com ou dans l’app {App} ; ton ordinateur cloud la conserve. Simeon ne voit jamais ton mot de passe ni tes numéros de carte."
          }
        }
      }
    },
    "You'll approve the connection on {App}'s own page with your {App} account; your cloud computer keeps it. Simeon never sees your password or your card numbers." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprobarás la conexión en la página de {App} con tu cuenta de {App}; tu computadora en la nube la guarda. Simeon nunca ve tu contraseña ni los números de tus tarjetas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu approuveras la connexion sur la page de {App} avec ton compte {App} ; ton ordinateur cloud la conserve. Simeon ne voit jamais ton mot de passe ni tes numéros de carte."
          }
        }
      }
    },
    "You'll sign in on %@'s own page, and %@ runs this connection from its own server (%@). Simeon never sees your password." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iniciarás sesión en la página de %@, y %@ gestiona esta conexión desde su propio servidor (%@). Simeon nunca ve tu contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu te connecteras sur la page de %@, et %@ gère cette connexion depuis son propre serveur (%@). Simeon ne voit jamais ton mot de passe."
          }
        }
      }
    },
    "You'll sign in on %@'s own page. Simeon never sees your password." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iniciarás sesión en la página de %@. Simeon nunca ve tu contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu te connecteras sur la page de %@. Simeon ne voit jamais ton mot de passe."
          }
        }
      }
    },
    "Your account was deleted." : {
      "localizations" : {
