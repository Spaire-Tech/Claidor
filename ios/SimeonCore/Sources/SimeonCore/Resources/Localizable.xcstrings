        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu oturumda başka bilgisayar güncellemesi ve sıfırlaması yapılamaz. Bilgisayar yeniden kullanılabilir olduğunda Simeon’u yeniden başlat."
