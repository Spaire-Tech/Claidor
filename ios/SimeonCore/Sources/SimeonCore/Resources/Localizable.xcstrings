    "Saving replaces all of %@'s setup values and applies them to its connectors. Current values aren't shown; a field left blank is cleared." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Sichern werden alle Einrichtungswerte von %@ ersetzt und auf seine Connectors angewendet. Aktuelle Werte werden nicht angezeigt; ein leeres Feld wird gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al guardar se reemplazan todos los valores de configuración de %@ y se aplican a sus conectores. Los valores actuales no se muestran; un campo vacío se borra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrer remplace toutes les valeurs de configuration de %@ et les applique à ses connecteurs. Les valeurs actuelles ne sont pas affichées ; un champ laissé vide est effacé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il salvataggio sostituisce tutti i valori di configurazione di %@ e li applica ai suoi connettori. I valori attuali non vengono mostrati; un campo lasciato vuoto viene cancellato."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaren vervangt alle configuratiewaarden van %@ en past ze toe op de connectors ervan. Huidige waarden worden niet getoond; een leeg veld wordt gewist."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po zachowaniu wszystkie wartości konfiguracji %@ zostaną zastąpione i zastosowane do powiązanych konektorów. Obecne wartości nie są pokazywane; puste pole zostanie wyczyszczone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvar substitui todos os valores de configuração de %@ e os aplica aos conectores dele. Os valores atuais não são mostrados; um campo deixado em branco é apagado."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du sparar ersätts alla konfigurationsvärden för %@ och de nya tillämpas på dess kopplingar. Nuvarande värden visas inte; ett fält som lämnas tomt rensas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydetmek, %@ kurulum değerlerinin tümünü değiştirir ve bunları bağlayıcılarına uygular. Mevcut değerler gösterilmez; boş bırakılan alan temizlenir."
          }
        }
      }
    },
    "Scenarios your agents run do real work in the apps they connect, and use your Make operations." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szenarien, die deine Agenten ausführen, erledigen echte Arbeit in den verbundenen Apps und verbrauchen deine Make-Operationen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los escenarios que ejecutan tus agentes hacen trabajo real en las apps que conectan y usan tus operaciones de Make."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les scénarios lancés par tes agents agissent pour de vrai dans les apps qu’ils relient, et utilisent tes opérations Make."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli scenari eseguiti dai tuoi agenti svolgono lavoro reale nelle app che collegano e usano le tue operazioni Make."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scenario’s die je agenten uitvoeren, doen echt werk in de apps die ze koppelen, en gebruiken je Make-operaties."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scenariusze uruchamiane przez twoich agentów działają naprawdę w łączonych aplikacjach i zużywają twoje operacje Make."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os cenários que seus agentes executam fazem trabalho real nos apps que eles conectam e usam suas operações do Make."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scenarier som dina agenter kör gör verkligt arbete i apparna de kopplar ihop och använder dina Make-operationer."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajanlarının çalıştırdığı senaryolar, bağladıkları uygulamalarda gerçek işler yapar ve Make operasyonlarını kullanır."
          }
        }
      }
