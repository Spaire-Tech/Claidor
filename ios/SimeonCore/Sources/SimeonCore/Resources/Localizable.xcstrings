    "7 days free, then your plan. Add a card on the web; cancel anytime." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 Tage gratis, danach dein Tarif. Füge im Web eine Karte hinzu; kündigen kannst du jederzeit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 días gratis y luego tu plan. Agrega una tarjeta en la web; cancela cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 jours gratuits, puis ton forfait. Ajoute une carte sur le web ; résilie quand tu veux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 giorni gratis, poi il tuo piano. Aggiungi una carta sul web; disdici quando vuoi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 dagen gratis, daarna je abonnement. Voeg een kaart toe op het web; opzeggen kan altijd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 dni za darmo, potem twój plan. Dodaj kartę na stronie; zrezygnuj w każdej chwili."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
