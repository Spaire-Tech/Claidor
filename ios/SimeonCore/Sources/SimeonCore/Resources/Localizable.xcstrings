          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus agentes podem pedir ao {App} um cartão de uso único para pagar algo que você pediu para eles comprarem, e ler as contas bancárias e de cartão que você escolher compartilhar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
