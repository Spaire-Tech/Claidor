        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso apaga para sempre o grupo e o histórico da conversa. Os agentes do grupo não são apagados e continuam disponíveis individualmente. Não é possível desfazer."
