    "There is no computer to update." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay ninguna computadora que actualizar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n’y a pas d’ordinateur à mettre à jour."
          }
        }
      }
    },
    "There's no Simeon subscription on this Apple ID to restore." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay ninguna suscripción de Simeon que restaurar en esta cuenta de Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun abonnement Simeon à restaurer sur cet identifiant Apple."
          }
        }
      }
    },
    "There's nothing to set up or purchase here." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí no hay nada que configurar ni comprar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n’y a rien à configurer ni à acheter ici."
          }
        }
      }
    },
    "There's nothing to sign in to: your agents draw on {App}'s own server (mcp.excalidraw.com), and Simeon holds no account of yours there." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No necesitas iniciar sesión: tus agentes dibujan en el servidor de {App} (mcp.excalidraw.com), y Simeon no guarda ninguna cuenta tuya ahí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune connexion n’est nécessaire : tes agents dessinent sur le serveur de {App} (mcp.excalidraw.com), et Simeon n’y détient aucun compte à toi."
          }
        }
      }
    },
    "They reset on Monday." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se renuevan el lunes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ils se renouvellent lundi."
          }
        }
      }
    },
    "They reset on Monday. Upgrade to keep going now." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se renuevan el lunes. Mejora tu plan para seguir ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ils se renouvellent lundi. Passe au forfait supérieur pour continuer dès maintenant."
          }
        }
      }
    },
    "Thinking" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pensando"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réflexion"
          }
        }
      }
    },
    "This account can try Simeon now." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta cuenta ya puede probar Simeon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce compte peut essayer Simeon dès maintenant."
          }
        }
      }
    },
    "This agent runs on your machine. There's no separate desktop to stream." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este agente se ejecuta en tu equipo. No hay un escritorio aparte que mostrar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet agent tourne sur ta machine. Il n’y a pas de bureau séparé à afficher."
          }
        }
      }
    },
    "This airline needs the passport." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta aerolínea pide el pasaporte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette compagnie demande le passeport."
          }
        }
      }
    },
    "This applies to Simeon and every agent. It can always be changed in Settings." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto se aplica a Simeon y a cada agente. Siempre puedes cambiarlo en Configuración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela s’applique à Simeon et à chaque agent. Tu peux toujours le changer dans Réglages."
          }
        }
      }
    },
    "This isn’t available right now" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto no está disponible en este momento"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce n’est pas disponible pour le moment"
          }
        }
      }
    },
    "This message can't be shown in this version of Simeon." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este mensaje no se puede mostrar en esta versión de Simeon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce message ne peut pas s’afficher dans cette version de Simeon."
          }
        }
      }
    },
    "This message is already sending and can't be canceled." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este mensaje ya se está enviando y no se puede cancelar."
