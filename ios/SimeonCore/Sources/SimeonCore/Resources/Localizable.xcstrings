    "The computer recovery failed. Try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wiederherstellung des Computers ist fehlgeschlagen. Versuch es noch mal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo recuperar la computadora. Vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La récupération de l’ordinateur a échoué. Réessaie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il recupero del computer non è riuscito. Riprova."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het herstel van de computer is mislukt. Probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się przywrócić komputera. Spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A recuperação do computador falhou. Tente de novo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Återställningen av datorn misslyckades. Försök igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilgisayar kurtarma başarısız oldu. Tekrar dene."
          }
        }
      }
    },
    "The computer recovery started, but Simeon can't track its progress. Restart Simeon after the computer is available again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wiederherstellung des Computers wurde gestartet, aber Simeon kann den Fortschritt nicht verfolgen. Starte Simeon neu, sobald der Computer wieder verfügbar ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recuperación de la computadora empezó, pero Simeon no puede seguir su progreso. Reinicia Simeon cuando la computadora vuelva a estar disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La récupération de l’ordinateur a démarré, mais Simeon ne peut pas suivre sa progression. Redémarre Simeon quand l’ordinateur est de nouveau disponible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il recupero del computer è iniziato, ma Simeon non riesce a seguirne l’avanzamento. Riavvia Simeon quando il computer sarà di nuovo disponibile."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het herstel van de computer is gestart, maar Simeon kan de voortgang niet volgen. Start Simeon opnieuw zodra de computer weer beschikbaar is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przywracanie komputera się rozpoczęło, ale Simeon nie może śledzić postępu. Uruchom ponownie aplikację Simeon, gdy komputer znów będzie dostępny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A recuperação do computador começou, mas o Simeon não consegue acompanhar o progresso. Reinicie o Simeon quando o computador estiver disponível de novo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Återställningen av datorn har startat, men Simeon kan inte följa förloppet. Starta om Simeon när datorn är tillgänglig igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilgisayar kurtarma başladı, ancak Simeon ilerlemeyi izleyemiyor. Bilgisayar yeniden kullanılabilir olduğunda Simeon’u yeniden başlat."
          }
        }
      }
    },
