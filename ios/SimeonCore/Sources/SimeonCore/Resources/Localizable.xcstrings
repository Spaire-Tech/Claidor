    "This recreates Simeon's computer and reconnects. Your agents, files, and logins are kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit wird Simeons Computer neu erstellt und wieder verbunden. Deine Agenten, Dateien und Anmeldungen bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto recrea la computadora de Simeon y vuelve a conectarla. Tus agentes, archivos e inicios de sesión se conservan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ordinateur de Simeon est recréé puis reconnecté. Tes agents, tes fichiers et tes connexions sont conservés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il computer di Simeon viene ricreato e riconnesso. I tuoi agenti, i file e gli accessi vengono conservati."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee wordt de computer van Simeon opnieuw aangemaakt en opnieuw verbonden. Je agenten, bestanden en logins blijven bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spowoduje to odtworzenie komputera Simeona i ponowne połączenie. Twoi agenci, pliki i sesje logowania zostaną zachowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso recria o computador do Simeon e reconecta. Seus agentes, arquivos e logins são mantidos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simeons dator återskapas och ansluts igen. Dina agenter, filer och inloggningar behålls."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem Simeon’un bilgisayarını yeniden oluşturur ve yeniden bağlanır. Ajanların, dosyaların ve oturumların korunur."
          }
        }
      }
    },
    "This run didn’t finish. It will try again at its next time." : {
