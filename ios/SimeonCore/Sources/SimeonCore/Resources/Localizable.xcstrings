    "Simeon connects %@ through a secure sign-in partner, who keeps its access for your agents. %@'s page may show the partner's name. Simeon never sees your password." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simeon verbindet %@ über einen sicheren Anmeldepartner, der den Zugriff für deine Agenten verwahrt. Auf der Seite von %@ wird eventuell der Name des Partners angezeigt. Simeon sieht dein Passwort nie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simeon conecta %@ a través de un socio de inicio de sesión seguro, que guarda su acceso para tus agentes. La página de %@ puede mostrar el nombre de ese socio. Simeon nunca ve tu contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simeon connecte %@ via un partenaire de connexion sécurisé, qui garde son accès pour tes agents. La page de %@ peut afficher le nom de ce partenaire. Simeon ne voit jamais ton mot de passe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simeon connette %@ tramite un partner di accesso sicuro, che conserva l’accesso per i tuoi agenti. La pagina di %@ potrebbe mostrare il nome del partner. Simeon non vede mai la tua password."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simeon koppelt %@ via een beveiligde inlogpartner, die de toegang voor je agenten bewaart. De pagina van %@ kan de naam van die partner tonen. Simeon ziet je wachtwoord nooit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simeon łączy %@ przez bezpiecznego partnera logowania, który przechowuje dostęp dla twoich agentów. Strona %@ może pokazywać nazwę partnera. Simeon nigdy nie widzi twojego hasła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Simeon conecta o %@ por meio de um parceiro de login seguro, que guarda o acesso para seus agentes. A página do %@ pode mostrar o nome do parceiro. O Simeon nunca vê sua senha."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simeon ansluter %@ via en säker inloggningspartner som behåller åtkomsten åt dina agenter. Sidan för %@ kan visa partnerns namn. Simeon ser aldrig ditt lösenord."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simeon, %@ bağlantısını güvenli bir giriş ortağı üzerinden kurar; bu ortak, erişimi ajanların için saklar. %@ sayfasında ortağın adı görünebilir. Simeon şifreni asla görmez."
          }
        }
      }
    },
