        }
      }
    },
    "%@ are working on Simeon's computer right now. Updating recreates the computer and interrupts their current turns. Files and logins are kept." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ travaillent en ce moment sur l’ordinateur de Simeon. La mise à jour recrée l’ordinateur et interrompt leur tour en cours. Les fichiers et les connexions sont conservés."
          }
        }
      }
    },
