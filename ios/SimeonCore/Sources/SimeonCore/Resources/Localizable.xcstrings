        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’image n’est pas revenue. Réessaie."
          }
        }
      }
    },
    "The picture maker won't draw that. It turns down characters from films, shows and games, real people, and some other subjects. Describe a picture of your own instead." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El generador de imágenes no dibuja eso. Rechaza personajes de películas, series y juegos, personas reales y algunos otros temas. Describe mejor una imagen tuya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le générateur d’images refuse de dessiner ça. Il écarte les personnages de films, de séries et de jeux, les personnes réelles et quelques autres sujets. Décris plutôt une image de ton invention."
          }
        }
      }
    },
    "The platform rejected this connection." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La plataforma rechazó esta conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La plateforme a refusé cette connexion."
          }
        }
      }
    },
    "The purchase didn't go to Link" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La compra no llegó a Link"
