    "Further computer updates and resets are disabled for this session. Restart Simeon after the computer is available again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weitere Updates und Zurücksetzungen des Computers sind für diese Sitzung deaktiviert. Starte Simeon neu, sobald der Computer wieder verfügbar ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las actualizaciones y los restablecimientos de la computadora quedan desactivados en esta sesión. Reinicia Simeon cuando la computadora vuelva a estar disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mises à jour et réinitialisations de l’ordinateur sont désactivées pour cette session. Redémarre Simeon quand l’ordinateur est de nouveau disponible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altri aggiornamenti e reimpostazioni del computer sono disattivati per questa sessione. Riavvia Simeon quando il computer sarà di nuovo disponibile."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verdere updates en resets van de computer zijn uitgeschakeld voor deze sessie. Start Simeon opnieuw zodra de computer weer beschikbaar is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolejne aktualizacje i resety komputera są wyłączone w tej sesji. Uruchom ponownie aplikację Simeon, gdy komputer znów będzie dostępny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novas atualizações e redefinições do computador estão desativadas nesta sessão. Reinicie o Simeon quando o computador estiver disponível de novo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fler uppdateringar och nollställningar av datorn är avstängda under den här sessionen. Starta om Simeon när datorn är tillgänglig igen."
