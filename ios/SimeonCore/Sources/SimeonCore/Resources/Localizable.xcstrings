    "%@ are installed, but their content can't be fetched until Simeon's computer can read the source repository." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ están instalados, pero su contenido no se puede obtener hasta que la computadora de Simeon pueda leer el repositorio de origen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sont installés, mais leur contenu ne peut pas être récupéré tant que l’ordinateur de Simeon ne peut pas lire le dépôt source."
          }
        }
      }
    },
    "%@ are working on Simeon's computer right now. Updating recreates the computer and interrupts their current turns. Files and logins are kept." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ están trabajando en la computadora de Simeon en este momento. Actualizar vuelve a crear la computadora e interrumpe sus turnos actuales. Los archivos y las sesiones iniciadas se conservan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ travaillent en ce moment sur l’ordinateur de Simeon. La mise à jour recrée l’ordinateur et interrompt leur tour en cours. Les fichiers et les connexions sont conservés."
          }
        }
      }
    },
