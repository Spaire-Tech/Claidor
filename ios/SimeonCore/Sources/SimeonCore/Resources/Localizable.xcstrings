    "Your account was deleted. Your subscription through Apple keeps running until you cancel it in Settings › your name › Subscriptions." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Account wurde gelöscht. Dein Abo über Apple läuft weiter, bis du es unter Einstellungen › dein Name › Abos kündigst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
