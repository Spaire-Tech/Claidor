    "Simeon connects %@ through a secure sign-in partner, who keeps its access for your agents. %@'s page may show the partner's name. Simeon never sees your password." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simeon conecta %@ a través de un socio de inicio de sesión seguro, que guarda su acceso para tus agentes. La página de %@ puede mostrar el nombre de ese socio. Simeon nunca ve tu contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simeon connecte %@ via un partenaire de connexion sécurisé, qui garde son accès pour tes agents. La page de %@ peut afficher le nom de ce partenaire. Simeon ne voit jamais ton mot de passe."
          }
        }
      }
    },
