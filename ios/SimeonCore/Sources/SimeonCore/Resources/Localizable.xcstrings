    "For teams building on Plaid: it reads your integration's dashboard, not your own bank accounts." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Teams, die auf Plaid entwickeln: Es liest das Dashboard deiner Integration, nicht deine eigenen Bankkonten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para equipos que desarrollan con Plaid: lee el panel de tu integración, no tus propias cuentas bancarias."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
