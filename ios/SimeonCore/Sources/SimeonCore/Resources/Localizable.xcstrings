    "%@ is installed, but their content can't be fetched until Simeon's computer can read the source repository." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist installiert, aber die Inhalte können erst abgerufen werden, wenn Simeons Computer das Quell-Repository lesen kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está instalado, pero su contenido no se puede obtener hasta que la computadora de Simeon pueda leer el repositorio de origen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est installé, mais son contenu ne peut pas être récupéré tant que l’ordinateur de Simeon ne peut pas lire le dépôt source."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è installato, ma il suo contenuto non può essere recuperato finché il computer di Simeon non riesce a leggere il repository di origine."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is geïnstalleerd, maar de inhoud kan pas worden opgehaald als de computer van Simeon de bronrepository kan lezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zainstalowano %@, ale zawartości nie da się pobrać, dopóki komputer Simeona nie będzie mógł odczytać repozytorium źródłowego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está instalado, mas o conteúdo dele não pode ser obtido até que o computador do Simeon consiga ler o repositório de origem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ är installerat, men innehållet kan inte hämtas förrän Simeons dator kan läsa källrepot."
