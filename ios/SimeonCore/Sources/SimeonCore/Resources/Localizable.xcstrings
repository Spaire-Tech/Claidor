    "%@ are installed, but their content can't be fetched until Simeon's computer can read the source repository." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sind installiert, aber ihre Inhalte können erst abgerufen werden, wenn Simeons Computer das Quell-Repository lesen kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ están instalados, pero su contenido no se puede obtener hasta que la computadora de Simeon pueda leer el repositorio de origen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sont installés, mais leur contenu ne peut pas être récupéré tant que l’ordinateur de Simeon ne peut pas lire le dépôt source."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sono installati, ma il loro contenuto non può essere recuperato finché il computer di Simeon non riesce a leggere il repository di origine."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ zijn geïnstalleerd, maar hun inhoud kan pas worden opgehaald als de computer van Simeon de bronrepository kan lezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ są zainstalowane, ale ich zawartości nie da się pobrać, dopóki komputer Simeona nie będzie mógł odczytać repozytorium źródłowego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ estão instalados, mas o conteúdo deles não pode ser obtido até que o computador do Simeon consiga ler o repositório de origem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ är installerade, men deras innehåll kan inte hämtas förrän Simeons dator kan läsa källrepot."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ yüklü, ancak Simeon’un bilgisayarı kaynak depoyu okuyabilene kadar içerikleri alınamıyor."
          }
        }
      }
    },
    "%@ are working on Simeon's computer right now. Updating recreates the computer and interrupts their current turns. Files and logins are kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ arbeiten gerade auf Simeons Computer. Beim Aktualisieren wird der Computer neu erstellt und ihre laufende Arbeit unterbrochen. Dateien und Anmeldungen bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ están trabajando en la computadora de Simeon en este momento. Actualizar vuelve a crear la computadora e interrumpe sus turnos actuales. Los archivos y las sesiones iniciadas se conservan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ travaillent en ce moment sur l’ordinateur de Simeon. La mise à jour recrée l’ordinateur et interrompt leur tour en cours. Les fichiers et les connexions sont conservés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ stanno lavorando sul computer di Simeon in questo momento. L’aggiornamento ricrea il computer e interrompe i loro turni in corso. File e accessi vengono conservati."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ werken nu op de computer van Simeon. Bijwerken maakt de computer opnieuw aan en onderbreekt hun huidige beurt. Bestanden en logins blijven bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pracują teraz na komputerze Simeona. Aktualizacja utworzy komputer od nowa i przerwie ich bieżącą pracę. Pliki i sesje logowania zostaną zachowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ estão trabalhando no computador do Simeon agora. Atualizar recria o computador e interrompe os turnos atuais deles. Arquivos e logins são mantidos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ arbetar på Simeons dator just nu. Uppdateringen återskapar datorn och avbryter det de håller på med. Filer och inloggningar behålls."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ şu anda Simeon’un bilgisayarında çalışıyor. Güncelleme bilgisayarı yeniden oluşturur ve o anki işlerini yarıda keser. Dosyalar ve oturumlar korunur."
          }
        }
      }
    },
