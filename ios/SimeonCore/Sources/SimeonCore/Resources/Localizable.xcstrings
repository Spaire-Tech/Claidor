    "Your account was deleted. Your subscription through Apple keeps running until you cancel it in Settings › your name › Subscriptions." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminó tu cuenta. Tu suscripción a través de Apple sigue activa hasta que la canceles en Configuración › tu nombre › Suscripciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton compte a été supprimé. Ton abonnement via Apple continue jusqu’à ce que tu le résilies dans Réglages › ton nom › Abonnements."
          }
        }
      }
    },
