{
  "name": "claidor-maty-runner",
  "version": "0.1.0",
  "private": true,
  "description": "Simeon Labs' cloud runner: takes one Maty job at a time and runs it as one model turn through Claidor's metered proxy.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "tsc --build",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
