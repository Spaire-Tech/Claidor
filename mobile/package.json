{
  "name": "simeon-ios",
  "version": "0.1.0",
  "private": true,
  "description": "Simeon on the iPhone: the Simeon window in a native shell, with sign-in, notifications and opening an agent from one",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "doctor": "npx expo-doctor",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "expo": "~57.0.27",
    "expo-application": "~57.0.3",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-device": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-notifications": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "esbuild": "0.28.2",
    "typescript": "~6.0.3"
  }
}
