<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
  xsi:type="TaskPaneApp">

  <!-- Ances in Excel.

       Excel only, by the product's own posture: the customer lives in
       Excel, and the panel audits the model they have open. The Word and
       PowerPoint hosts this manifest used to register are retired with
       that decision — their bridge code stays in `src/host/` dormant, and
       re-adding a <Host> line here is all it would take to wake one.

       The Id is unchanged from the first release on purpose: Office
       treats the Id as the add-in's identity, so re-adding this manifest
       *updates* the existing install instead of standing a second add-in
       beside it.

       Outlook remains a separate file — `manifest.outlook.xml` — because
       a MailApp is a different xsi:type; it is dormant and not offered
       anywhere in the product.

       YOUR-DOMAIN.example.com is a placeholder on purpose — a manifest is
       a deployment artifact. `scripts/stamp-manifests.mjs` writes stamped
       copies into dist/, and the dashboard's build does that on every
       deploy (see SIDELOAD.md). The manifest names a live origin; Office
       will not load a task pane from a file path. -->

  <Id>3e1b9a24-7c05-4d18-9f6e-2a41c8d5b730</Id>
  <Version>1.1.0.0</Version>
  <ProviderName>Ances</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Ances" />
  <Description DefaultValue="Audits the model you have open — every check an auditor runs, each one pointing at a cell." />
  <IconUrl DefaultValue="https://YOUR-DOMAIN.example.com/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://YOUR-DOMAIN.example.com/assets/icon-80.png" />
  <SupportUrl DefaultValue="https://YOUR-DOMAIN.example.com/support" />

  <!-- Every origin the pane may navigate to. Office blocks the rest, which
       is why the sign-in dialog opens on our own domain and hands a token
       back rather than redirecting anywhere. -->
  <AppDomains>
    <AppDomain>https://YOUR-DOMAIN.example.com</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Workbook" />
  </Hosts>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://YOUR-DOMAIN.example.com/index.html" />
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>

      <!-- Excel. The model's own host: an audit finding names a cell, and
           a cell is a coordinate Excel selects as it stands. -->
      <Host xsi:type="Workbook">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title" />
            <Description resid="GetStarted.Description" />
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl" />
          </GetStarted>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="Ances.Group.Excel">
                <Label resid="Group.Label" />
                <Icon>
                  <bt:Image size="16" resid="Icon.16" />
                  <bt:Image size="32" resid="Icon.32" />
                  <bt:Image size="80" resid="Icon.80" />
                </Icon>
                <Control xsi:type="Button" id="Ances.Open.Excel">
                  <Label resid="Button.Label" />
                  <Supertip>
                    <Title resid="Button.Label" />
                    <Description resid="Button.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16" />
                    <bt:Image size="32" resid="Icon.32" />
                    <bt:Image size="80" resid="Icon.80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>Ances.Taskpane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>

    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16" DefaultValue="https://YOUR-DOMAIN.example.com/assets/icon-16.png" />
        <bt:Image id="Icon.32" DefaultValue="https://YOUR-DOMAIN.example.com/assets/icon-32.png" />
        <bt:Image id="Icon.80" DefaultValue="https://YOUR-DOMAIN.example.com/assets/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://YOUR-DOMAIN.example.com/index.html" />
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://YOUR-DOMAIN.example.com/index.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="Ances is ready" />
        <bt:String id="Group.Label" DefaultValue="Ances" />
        <bt:String id="Button.Label" DefaultValue="Ances" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Open the panel to audit the model in front of you. Every finding points at the cell it came from." />
        <bt:String id="Button.Tooltip" DefaultValue="Audit the model you have open." />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
