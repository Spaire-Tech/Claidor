<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
  xsi:type="TaskPaneApp">

  <!-- Production manifest. Served from https://YOUR-DOMAIN.example.com -->
  <Id>dece6c8d-a000-4167-87d1-1d6b205340a0</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Claidor</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Claidor for Word" />
  <Description DefaultValue="Contract review, playbooks, drafting, and US legal research inside Word. Grounded redlines applied as native tracked changes." />
  <IconUrl DefaultValue="https://YOUR-DOMAIN.example.com/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://YOUR-DOMAIN.example.com/assets/icon-80.png" />
  <SupportUrl DefaultValue="https://YOUR-DOMAIN.example.com/support" />

  <!-- Domains the task pane is allowed to navigate to.

       The sign-in dialog opened by Office.context.ui.displayDialogAsync
       starts on the identity provider, so that origin must be listed or
       Office refuses to open it: "The domain of the URL is not included in
       the AppDomains element". Microsoft Entra is the only sign-in Claidor
       offers; upstream listed Supabase and Google here instead. -->
  <AppDomains>
    <AppDomain>https://YOUR-DOMAIN.example.com</AppDomain>
    <AppDomain>https://YOUR-API-DOMAIN.example.com</AppDomain>
    <AppDomain>https://login.microsoftonline.com</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Document" />
  </Hosts>

  <!-- Hard floor: WordApi 1.6 gives change tracking, tracked-change
       enumeration/accept-reject, comments, and custom XML parts, all GA. -->
  <Requirements>
    <Sets DefaultMinVersion="1.6">
      <Set Name="WordApi" MinVersion="1.6" />
    </Sets>
  </Requirements>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://YOUR-DOMAIN.example.com/index.html" />
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Document">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title" />
            <Description resid="GetStarted.Description" />
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl" />
          </GetStarted>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="Claidor.Group">
                <Label resid="Claidor.Group.Label" />
                <Icon>
                  <bt:Image size="16" resid="Icon.16" />
                  <bt:Image size="32" resid="Icon.32" />
                  <bt:Image size="80" resid="Icon.80" />
                </Icon>
                <Control xsi:type="Button" id="Claidor.OpenPane">
                  <Label resid="Claidor.OpenPane.Label" />
                  <Supertip>
                    <Title resid="Claidor.OpenPane.Label" />
                    <Description resid="Claidor.OpenPane.Tip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16" />
                    <bt:Image size="32" resid="Icon.32" />
                    <bt:Image size="80" resid="Icon.80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>Claidor.Taskpane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
          <!-- Right-click a text selection to open Claidor where the cursor is. -->
          <ExtensionPoint xsi:type="ContextMenu">
            <OfficeMenu id="ContextMenuText">
              <Control xsi:type="Button" id="Claidor.ContextReview">
                <Label resid="Claidor.Context.Label" />
                <Supertip>
                  <Title resid="Claidor.Context.Label" />
                  <Description resid="Claidor.OpenPane.Tip" />
                </Supertip>
                <Icon>
                  <bt:Image size="16" resid="Icon.16" />
                  <bt:Image size="32" resid="Icon.32" />
                  <bt:Image size="80" resid="Icon.80" />
                </Icon>
                <Action xsi:type="ShowTaskpane">
                  <TaskpaneId>Claidor.Taskpane</TaskpaneId>
                  <SourceLocation resid="Taskpane.Url" />
                </Action>
              </Control>
            </OfficeMenu>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16" DefaultValue="https://YOUR-DOMAIN.example.com/assets/icon-16.png" />
        <bt:Image id="Icon.32" DefaultValue="https://YOUR-DOMAIN.example.com/assets/icon-32.png" />
        <bt:Image id="Icon.80" DefaultValue="https://YOUR-DOMAIN.example.com/assets/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://YOUR-DOMAIN.example.com/index.html" />
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://YOUR-DOMAIN.example.com/word" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="Claidor for Word is ready" />
        <bt:String id="Claidor.Group.Label" DefaultValue="Claidor" />
        <bt:String id="Claidor.OpenPane.Label" DefaultValue="Open Claidor" />
        <bt:String id="Claidor.Context.Label" DefaultValue="Review with Claidor" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Open the Claidor pane to review this contract, apply grounded redlines, and draft clauses." />
        <bt:String id="Claidor.OpenPane.Tip" DefaultValue="Review the open contract, apply tracked-change redlines, and run drafting and research." />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
