<?xml version="1.0" encoding="UTF-8"?>
<!--
  Word add-in manifest.

  Requirements are deliberately set at WordApi 1.3, not 1.4. Tracked
  changes need 1.4, but declaring 1.4 here stops the add-in loading at all
  on an older host; declaring 1.3 lets it load and lets capabilities.ts
  probe for what is actually available. A firm on an old build gets the
  checks and is told plainly that applying fixes needs a newer Word,
  rather than an add-in that silently is not there.
-->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
  xsi:type="TaskPaneApp">

  <Id>4EBC9F97-2C6E-55E3-B86F-B56C67AD0F0B</Id>
  <Version>0.1.0.0</Version>
  <ProviderName>Claidor</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Claidor" />
  <Description DefaultValue="Check a document's defined terms, cross-references and numbering, and apply fixes as tracked changes." />
  <IconUrl DefaultValue="https://localhost:3100/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://localhost:3100/icon-64.png" />
  <SupportUrl DefaultValue="https://claidor.com/support" />

  <AppDomains>
    <AppDomain>https://api.claidor.com</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Document" />
  </Hosts>

  <Requirements>
    <Sets DefaultMinVersion="1.3">
      <Set Name="WordApi" MinVersion="1.3" />
    </Sets>
  </Requirements>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:3100/index.html" />
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Document">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title" />
            <Description resid="GetStarted.Description" />
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl" />
          </GetStarted>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="Claidor.Group">
                <Label resid="Claidor.GroupLabel" />
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16" />
                  <bt:Image size="32" resid="Icon.32x32" />
                  <bt:Image size="80" resid="Icon.80x80" />
                </Icon>
                <Control xsi:type="Button" id="Claidor.CheckButton">
                  <Label resid="Claidor.CheckLabel" />
                  <Supertip>
                    <Title resid="Claidor.CheckLabel" />
                    <Description resid="Claidor.CheckTip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>Claidor.Taskpane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://localhost:3100/icon-16.png" />
        <bt:Image id="Icon.32x32" DefaultValue="https://localhost:3100/icon-32.png" />
        <bt:Image id="Icon.80x80" DefaultValue="https://localhost:3100/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://localhost:3100/index.html" />
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://claidor.com/support" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Claidor.GroupLabel" DefaultValue="Claidor" />
        <bt:String id="Claidor.CheckLabel" DefaultValue="Check" />
        <bt:String id="GetStarted.Title" DefaultValue="Claidor is ready." />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="Claidor.CheckTip" DefaultValue="Check defined terms, cross-references and numbering in this document." />
        <bt:String id="GetStarted.Description" DefaultValue="Open the Claidor pane from the Home tab to check this document." />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
