{
  "id": "search-library",
  "name": "Search Library",
  "description": "Searches the person's own documents indexed by Swen desktop.",
  "contracts": {
    "tools": [
      "search_library"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "callbackUrl": {
        "type": "string",
        "description": "Swen HTTP callback URL for library searches"
      },
      "secret": {
        "type": "string",
        "description": "Shared secret for callback authentication"
      }
    }
  }
}
