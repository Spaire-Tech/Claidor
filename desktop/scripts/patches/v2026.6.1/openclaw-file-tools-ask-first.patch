+// Lazy boundary for file-tool approvals. The approval request pulls in the
+// exec runtime (process supervisor, shell snapshot), which the tool factory
+// keeps off the startup path; this module is loaded only when a file tool
+// actually has to ask.
+export { requestExecApprovalDecision } from "./bash-tools.exec-approval-request.js";
diff --git a/src/agents/file-tool-approval.test.ts b/src/agents/file-tool-approval.test.ts
new file mode 100644
index 00000000..0adede1c
--- /dev/null
+++ b/src/agents/file-tool-approval.test.ts
@@ -0,0 +1,369 @@
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import type { AnyAgentTool } from "./agent-tools.types.js";
+import {
+  applyPatchPathExtractor,
+  buildFileAccessCommand,
+  decideFileToolAccess,
+  FILE_ACCESS_COMMAND_HEAD,
+  pathParamExtractor,
+  resolvePathsOutsideFreeRoots,
+  rulesAfterAllowAlways,
+  rulesCoverAll,
+  wrapToolWithFileApproval,
+  type FileToolApprovalRule,
+} from "./file-tool-approval.js";
+
+let tmp: string;
+let workspace: string;
+let stateDir: string;
+let personal: string;
+
+beforeEach(() => {
+  tmp = fs.mkdtempSync(path.join(os.tmpdir(), "file-tool-approval-"));
+  workspace = path.join(tmp, "state", "workspace-main");
+  stateDir = path.join(tmp, "state");
+  personal = path.join(tmp, "Documents");
+  fs.mkdirSync(workspace, { recursive: true });
+  fs.mkdirSync(path.join(stateDir, "projects", "acme"), { recursive: true });
+  fs.mkdirSync(personal, { recursive: true });
+  // Paths come back canonical, so compare against canonical roots: the OS
+  // temp dir is a symlink on macOS.
+  tmp = fs.realpathSync(tmp);
+  workspace = fs.realpathSync(workspace);
+  stateDir = fs.realpathSync(stateDir);
+  personal = fs.realpathSync(personal);
+});
+
+afterEach(() => {
+  fs.rmSync(tmp, { recursive: true, force: true });
+});
+
+function context(overrides: Partial<Parameters<typeof decideFileToolAccess>[0]["context"]> = {}) {
+  return {
+    agentId: "main",
+    sessionKey: "agent:main:main",
+    cwd: personal,
+    freeRoots: [workspace, stateDir],
+    policy: { security: "allowlist" as const, ask: "on-miss" as const },
+    ...overrides,
+  };
+}
+
+function deps(overrides: Partial<Parameters<typeof decideFileToolAccess>[1]> = {}) {
+  const rules = new Map<string, FileToolApprovalRule[]>();
+  return {
+    requestDecision: vi.fn(async () => "allow-once" as string | null),
+    loadRules: vi.fn((agentKey: string) => rules.get(agentKey) ?? []),
+    saveRules: vi.fn((agentKey: string, next: FileToolApprovalRule[]) => {
+      rules.set(agentKey, next);
+    }),
+    resolveHostPolicy: vi.fn(() => ({
+      security: "allowlist" as const,
+      ask: "on-miss" as const,
+      askFallback: "deny" as const,
+    })),
+    ...overrides,
+  };
+}
+
+describe("resolvePathsOutsideFreeRoots", () => {
+  it("leaves the agent's own workspace and the state dir alone", async () => {
+    const outside = await resolvePathsOutsideFreeRoots({
+      paths: [
+        path.join(workspace, "MEMORY.md"),
+        path.join(stateDir, "projects", "acme", "PROJECT.md"),
+        path.join(personal, "report.docx"),
+      ],
+      cwd: personal,
+      freeRoots: [workspace, stateDir],
+    });
+    expect(outside).toEqual([path.join(personal, "report.docx")]);
+  });
+
+  it("resolves a relative path against the tools' root, like the tools do", async () => {
+    const outside = await resolvePathsOutsideFreeRoots({
+      paths: ["notes/todo.md"],
+      cwd: personal,
+      freeRoots: [workspace],
+    });
+    expect(outside).toEqual([path.join(personal, "notes", "todo.md")]);
+  });
+
+  it("does not let a symlink inside the workspace reach outside it", async () => {
+    // A link in the free root that points at the person's folder must be
+    // judged by where it lands, not where it sits.
+    const link = path.join(workspace, "escape");
+    fs.symlinkSync(personal, link, "dir");
+    const outside = await resolvePathsOutsideFreeRoots({
+      paths: [path.join(link, "secret.txt")],
+      cwd: personal,
+      freeRoots: [workspace],
+    });
+    expect(outside).toEqual([path.join(fs.realpathSync(personal), "secret.txt")]);
+  });
+
+  it("names a shared prefix only once", async () => {
+    const outside = await resolvePathsOutsideFreeRoots({
+      paths: ["a.txt", "./a.txt", "a.txt"],
+      cwd: personal,
+      freeRoots: [workspace],
+    });
+    expect(outside).toHaveLength(1);
+  });
+});
+
+describe("decideFileToolAccess", () => {
+  it("does not ask for the agent's own files", async () => {
+    const d = deps();
+    const outcome = await decideFileToolAccess(
+      { kind: "write", paths: [path.join(workspace, "MEMORY.md")], context: context() },
+      d,
+    );
+    expect(outcome).toEqual({ allowed: true });
+    expect(d.requestDecision).not.toHaveBeenCalled();
+    expect(d.resolveHostPolicy).not.toHaveBeenCalled();
+  });
+
+  it("asks through the exec approval request for a file of the person's", async () => {
+    const d = deps();
+    const target = path.join(personal, "report.docx");
+    const outcome = await decideFileToolAccess(
+      { kind: "write", paths: [target], context: context() },
+      d,
+    );
+    expect(outcome).toEqual({ allowed: true });
+    expect(d.requestDecision).toHaveBeenCalledTimes(1);
+    const request = d.requestDecision.mock.calls[0][0];
+    expect(request.command).toBe(`${FILE_ACCESS_COMMAND_HEAD} write ${target}`);
+    expect(request.commandArgv).toEqual([FILE_ACCESS_COMMAND_HEAD, "write", target]);
+    expect(request.host).toBe("gateway");
+    expect(request.agentId).toBe("main");
+    expect(request.sessionKey).toBe("agent:main:main");
+    expect(request.cwd).toBe(personal);
+    expect(request.security).toBe("allowlist");
+    expect(request.ask).toBe("on-miss");
+  });
+
+  it("refuses when the person says no, and says so", async () => {
+    const d = deps({ requestDecision: vi.fn(async () => "deny") });
+    const outcome = await decideFileToolAccess(
+      { kind: "read", paths: [path.join(personal, "a.txt")], context: context() },
+      d,
+    );
+    expect(outcome).toEqual({ allowed: false, reason: "approval-denied" });
+  });
+
+  it("remembers Always as the folder, for that kind, and stops asking", async () => {
+    const d = deps({ requestDecision: vi.fn(async () => "allow-always") });
+    const first = await decideFileToolAccess(
+      { kind: "write", paths: [path.join(personal, "a.txt")], context: context() },
+      d,
+    );
+    expect(first).toEqual({ allowed: true });
+    expect(d.saveRules).toHaveBeenCalledWith("main", [
+      expect.objectContaining({ kind: "write", dir: personal }),
+    ]);
+
+    const second = await decideFileToolAccess(
+      { kind: "write", paths: [path.join(personal, "b.txt")], context: context() },
+      d,
+    );
+    expect(second).toEqual({ allowed: true });
+    // A write rule covers reads of the same folder.
+    const read = await decideFileToolAccess(
+      { kind: "read", paths: [path.join(personal, "c.txt")], context: context() },
+      d,
+    );
+    expect(read).toEqual({ allowed: true });
+    expect(d.requestDecision).toHaveBeenCalledTimes(1);
+
+    // But not a sibling folder, and not a parent.
+    const elsewhere = await decideFileToolAccess(
+      { kind: "write", paths: [path.join(tmp, "Desktop", "d.txt")], context: context() },
+      d,
+    );
+    expect(elsewhere).toEqual({ allowed: true });
+    expect(d.requestDecision).toHaveBeenCalledTimes(2);
+  });
+
+  it("a read rule does not cover a write", () => {
+    const rules: FileToolApprovalRule[] = [{ kind: "read", dir: personal, createdAt: 1 }];
+    expect(rulesCoverAll(rules, "read", [path.join(personal, "a")])).toBe(true);
+    expect(rulesCoverAll(rules, "write", [path.join(personal, "a")])).toBe(false);
+  });
+
+  it("does not remember Always when the policy asks every time", async () => {
+    const d = deps({
+      requestDecision: vi.fn(async () => "allow-always"),
+      resolveHostPolicy: vi.fn(() => ({
+        security: "allowlist" as const,
+        ask: "always" as const,
+        askFallback: "deny" as const,
+      })),
+    });
+    const outcome = await decideFileToolAccess(
+      { kind: "write", paths: [path.join(personal, "a.txt")], context: context() },
+      d,
+    );
+    expect(outcome).toEqual({ allowed: true });
+    expect(d.saveRules).not.toHaveBeenCalled();
+  });
+
+  it("runs without asking under full/off, and refuses under deny", async () => {
+    const full = deps({
+      resolveHostPolicy: vi.fn(() => ({
+        security: "full" as const,
+        ask: "off" as const,
+        askFallback: "full" as const,
+      })),
+    });
+    expect(
+      await decideFileToolAccess(
+        { kind: "write", paths: [path.join(personal, "a.txt")], context: context() },
+        full,
+      ),
+    ).toEqual({ allowed: true });
+    expect(full.requestDecision).not.toHaveBeenCalled();
+
+    const deny = deps({
+      resolveHostPolicy: vi.fn(() => ({
+        security: "deny" as const,
+        ask: "off" as const,
+        askFallback: "deny" as const,
+      })),
+    });
+    expect(
+      await decideFileToolAccess(
+        { kind: "read", paths: [path.join(personal, "a.txt")], context: context() },
+        deny,
+      ),
+    ).toEqual({ allowed: false, reason: "security=deny" });
+    expect(deny.requestDecision).not.toHaveBeenCalled();
+  });
+
+  it("treats no answer as the approvals file's fallback says", async () => {
+    const expired = deps({ requestDecision: vi.fn(async () => null) });
+    expect(
+      await decideFileToolAccess(
+        { kind: "write", paths: [path.join(personal, "a.txt")], context: context() },
+        expired,
+      ),
+    ).toEqual({ allowed: false, reason: "approval-timeout" });
+
+    const lenient = deps({
+      requestDecision: vi.fn(async () => null),
+      resolveHostPolicy: vi.fn(() => ({
+        security: "allowlist" as const,
+        ask: "on-miss" as const,
+        askFallback: "full" as const,
+      })),
+    });
+    expect(
+      await decideFileToolAccess(
+        { kind: "write", paths: [path.join(personal, "a.txt")], context: context() },
+        lenient,
+      ),
+    ).toEqual({ allowed: true });
+  });
+});
+
+describe("rulesAfterAllowAlways", () => {
+  it("adds one rule per folder and never a duplicate", () => {
+    const rules = rulesAfterAllowAlways(
+      [],
+      "write",
+      [path.join(personal, "a.txt"), path.join(personal, "b.txt"), path.join(tmp, "c.txt")],
+      5,
+    );
+    expect(rules).toEqual([
+      { kind: "write", dir: personal, createdAt: 5 },
+      { kind: "write", dir: tmp, createdAt: 5 },
+    ]);
+    expect(rulesAfterAllowAlways(rules, "write", [path.join(personal, "z.txt")], 9)).toEqual(rules);
+  });
+});
+
+describe("extractors", () => {
+  it("reads the path params the tool would use", () => {
+    expect(pathParamExtractor()({ path: "a.txt", content: "x" }, "/cwd")).toEqual(["a.txt"]);
+    expect(pathParamExtractor()({ content: "x" }, "/cwd")).toEqual([]);
+    expect(pathParamExtractor()("not an object", "/cwd")).toEqual([]);
+  });
+
+  it("finds every file an apply_patch envelope would touch", () => {
+    const patch = [
+      "*** Begin Patch",
+      "*** Add File: new.txt",
+      "+hello",
+      "*** Update File: old.txt",
+      "*** Move to: renamed.txt",
+      "@@",
+      "-a",
+      "+b",
+      "*** Delete File: gone.txt",
+      "*** End Patch",
+    ].join("\n");
+    const paths = applyPatchPathExtractor({ input: patch }, personal);
+    expect(paths).toEqual([
+      path.join(personal, "new.txt"),
+      path.join(personal, "old.txt"),
+      path.join(personal, "renamed.txt"),
+      path.join(personal, "gone.txt"),
+    ]);
+  });
+});
+
+describe("wrapToolWithFileApproval", () => {
+  const tool: AnyAgentTool = {
+    name: "write",
+    label: "Write",
+    description: "write",
+    parameters: {} as never,
+    execute: vi.fn(async () => ({ content: [{ type: "text", text: "wrote" }], details: {} })),
+  } as unknown as AnyAgentTool;
+
+  it("runs the tool when allowed and returns a refusal the model can read when not", async () => {
+    const allowed = wrapToolWithFileApproval(
+      tool,
+      { kind: "write", context: context(), extractPaths: pathParamExtractor() },
+      deps(),
+    );
+    const ran = await allowed.execute(
+      "call-1",
+      { path: "a.txt", content: "x" },
+      undefined as never,
+      undefined as never,
+    );
+    expect(ran.content).toEqual([{ type: "text", text: "wrote" }]);
+
+    const refused = wrapToolWithFileApproval(
+      tool,
+      { kind: "write", context: context(), extractPaths: pathParamExtractor() },
+      deps({ requestDecision: vi.fn(async () => "deny") }),
+    );
+    const result = await refused.execute(
+      "call-2",
+      { path: "a.txt", content: "x" },
+      undefined as never,
+      undefined as never,
+    );
+    expect(result.content[0]).toEqual({
+      type: "text",
+      text: `File write denied (approval-denied): ${path.join(personal, "a.txt")}`,
+    });
+    expect(result.details).toMatchObject({
+      status: "denied",
+      kind: "write",
+      reason: "approval-denied",
+    });
+  });
+
+  it("names the command in a form no shell has, so a client can tell it apart", () => {
+    const { command, commandArgv } = buildFileAccessCommand("read", ["/a", "/b"]);
+    expect(command).toBe("file-access read /a /b");
+    expect(commandArgv).toEqual(["file-access", "read", "/a", "/b"]);
+  });
+});
