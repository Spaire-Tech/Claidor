+++ b/src/agents/file-tool-approval.ts
@@ -0,0 +1,424 @@
+import crypto from "node:crypto";
+import fs from "node:fs";
+import path from "node:path";
+import {
+  maxAsk,
+  minSecurity,
+  resolveExecApprovals,
+  resolveExecApprovalsPath,
+  type ExecAsk,
+  type ExecSecurity,
+} from "../infra/exec-approvals.js";
+import { canonicalPathFromExistingAncestor } from "../infra/fs-safe.js";
+import { expandHomePrefix, resolveOsHomeDir } from "../infra/home-dir.js";
+import { getToolParamsRecord } from "./agent-tools.params.js";
+import type { AnyAgentTool } from "./agent-tools.types.js";
+import { extractApplyPatchTargetPaths } from "./apply-patch-paths.js";
+import type { RequestExecApprovalDecisionParams } from "./bash-tools.exec-approval-request.js";
+import { textResult } from "./tools/common.js";
+
+/**
+ * File tools ask before touching a file that is not the agent's own.
+ *
+ * `read`, `write`, `edit` and `apply_patch` reach the whole disk and, unlike
+ * `exec`, have no approval of their own; `tools.fs.workspaceOnly` is measured
+ * from the session cwd, so it neither asks nor fences the person's folder.
+ * This wrapper gives the four tools the same approval a command gets: the
+ * same gateway request, the same card, the same decisions.
+ *
+ * Paths under a *free root* — the agent's workspace (its memory and notes),
+ * the engine state directory (every agent's workspace, shared project notes),
+ * and skill roots — never ask. Everything else is the person's, and asks
+ * under the exec policy for the agent: `full`/`off` runs, `deny` refuses,
+ * otherwise the card. "Always" on the card is remembered as the target's
+ * directory for that kind of access, so a folder answered once stays
+ * answered; a write rule also covers reads of that folder.
+ *
+ * The request is marked with the `file-access` argv head so a client can
+ * draw it as a file card rather than a command, and must not treat the
+ * decision like a two-phase exec approval: the tool blocks on the decision
+ * and continues in the same turn.
+ */
+
+export type FileToolApprovalKind = "read" | "write";
+
+export const FILE_ACCESS_COMMAND_HEAD = "file-access";
+
+export type FileToolApprovalPolicy = {
+  security: ExecSecurity;
+  ask: ExecAsk;
+};
+
+export type FileToolApprovalContext = {
+  agentId?: string;
+  sessionKey?: string;
+  /** Where a relative path resolves; the coding tools' root. */
+  cwd: string;
+  /** Paths under these never ask. */
+  freeRoots: readonly string[];
+  /** The configured exec policy; the approvals file may tighten it. */
+  policy: FileToolApprovalPolicy;
+};
+
+export type FileToolApprovalRule = {
+  kind: FileToolApprovalKind;
+  dir: string;
+  createdAt: number;
+};
+
+type FileToolApprovalsFile = {
+  version: 1;
+  agents: Record<string, { rules: FileToolApprovalRule[] }>;
+};
+
+type FileToolApprovalDependencies = {
+  requestDecision: (params: RequestExecApprovalDecisionParams) => Promise<string | null>;
+  loadRules: (agentKey: string) => FileToolApprovalRule[];
+  saveRules: (agentKey: string, rules: FileToolApprovalRule[]) => void;
+  resolveHostPolicy: (params: { agentId?: string; policy: FileToolApprovalPolicy }) => {
+    security: ExecSecurity;
+    ask: ExecAsk;
+    askFallback: ExecSecurity;
+  };
+};
+
+const DEFAULT_AGENT_KEY = "main";
+const FILE_APPROVALS_FILE_NAME = "file-approvals.json";
+
+export function resolveFileApprovalsPath(): string {
+  return path.join(path.dirname(resolveExecApprovalsPath()), FILE_APPROVALS_FILE_NAME);
+}
+
+function readFileApprovals(): FileToolApprovalsFile {
+  const empty: FileToolApprovalsFile = { version: 1, agents: {} };
+  const filePath = resolveFileApprovalsPath();
+  try {
+    if (!fs.existsSync(filePath)) {
+      return empty;
+    }
+    const parsed = JSON.parse(fs.readFileSync(filePath, "utf8")) as Partial<FileToolApprovalsFile>;
+    if (parsed?.version !== 1 || !parsed.agents || typeof parsed.agents !== "object") {
+      return empty;
+    }
+    const agents: FileToolApprovalsFile["agents"] = {};
+    for (const [agentKey, entry] of Object.entries(parsed.agents)) {
+      const rules = Array.isArray(entry?.rules) ? entry.rules : [];
+      agents[agentKey] = {
+        rules: rules.filter(
+          (rule): rule is FileToolApprovalRule =>
+            Boolean(rule) &&
+            (rule.kind === "read" || rule.kind === "write") &&
+            typeof rule.dir === "string" &&
+            path.isAbsolute(rule.dir),
+        ),
+      };
+    }
+    return { version: 1, agents };
+  } catch {
+    return empty;
+  }
+}
+
+function writeFileApprovals(file: FileToolApprovalsFile): void {
+  const filePath = resolveFileApprovalsPath();
+  const dir = path.dirname(filePath);
+  fs.mkdirSync(dir, { recursive: true, mode: 0o700 });
+  const tempPath = path.join(
+    dir,
+    `.${FILE_APPROVALS_FILE_NAME}.${process.pid}.${crypto.randomUUID()}.tmp`,
+  );
+  fs.writeFileSync(tempPath, `${JSON.stringify(file, null, 2)}\n`, { mode: 0o600, flag: "wx" });
+  try {
+    fs.renameSync(tempPath, filePath);
+  } catch (error) {
+    try {
+      fs.unlinkSync(tempPath);
+    } catch {
+      // Best effort.
+    }
+    throw error;
+  }
+}
+
+function loadRulesFromDisk(agentKey: string): FileToolApprovalRule[] {
+  return readFileApprovals().agents[agentKey]?.rules ?? [];
+}
+
+function saveRulesToDisk(agentKey: string, rules: FileToolApprovalRule[]): void {
+  const file = readFileApprovals();
+  file.agents[agentKey] = { rules };
+  writeFileApprovals(file);
+}
+
+/**
+ * The policy the exec tool would apply to a command from this agent:
+ * the configured layer, tightened by the approvals file (never loosened),
+ * exactly as `resolveExecHostApprovalContext` does for `exec`.
+ */
+function resolveHostPolicyFromApprovals(params: {
+  agentId?: string;
+  policy: FileToolApprovalPolicy;
+}): { security: ExecSecurity; ask: ExecAsk; askFallback: ExecSecurity } {
+  const approvals = resolveExecApprovals(params.agentId, {
+    security: params.policy.security,
+    ask: params.policy.ask,
+  });
+  const security = minSecurity(params.policy.security, approvals.agent.security);
+  const ask = maxAsk(params.policy.ask, approvals.agent.ask);
+  const askFallback = minSecurity(security, approvals.agent.askFallback);
+  return { security, ask, askFallback };
+}
+
+const defaultDependencies: FileToolApprovalDependencies = {
+  requestDecision: async (params) => {
+    const { requestExecApprovalDecision } = await import("./file-tool-approval.runtime.js");
+    return await requestExecApprovalDecision(params);
+  },
+  loadRules: loadRulesFromDisk,
+  saveRules: saveRulesToDisk,
+  resolveHostPolicy: resolveHostPolicyFromApprovals,
+};
+
+function expandTilde(filePath: string): string {
+  const home = resolveOsHomeDir();
+  return home ? expandHomePrefix(filePath, { home }) : filePath;
+}
+
+/** Absolute, tilde expanded, relative to the tools' root — as the tools resolve it. */
+export function resolveFileToolPath(filePath: string, cwd: string): string {
+  return path.resolve(cwd, expandTilde(filePath.trim()));
+}
+
+async function canonicalize(filePath: string): Promise<string> {
+  try {
+    return await canonicalPathFromExistingAncestor(filePath);
+  } catch {
+    return filePath;
+  }
+}
+
+function isInside(root: string, filePath: string): boolean {
+  const relative = path.relative(root, filePath);
+  return relative === "" || (!relative.startsWith("..") && !path.isAbsolute(relative));
+}
+
+/**
+ * The paths a call would touch that are not the agent's own, canonical and
+ * de-duplicated. Empty means nothing to ask about.
+ */
+export async function resolvePathsOutsideFreeRoots(params: {
+  paths: readonly string[];
+  cwd: string;
+  freeRoots: readonly string[];
+}): Promise<string[]> {
+  const roots = await Promise.all(
+    params.freeRoots.map(async (root) => canonicalize(path.resolve(root))),
+  );
+  const outside: string[] = [];
+  const seen = new Set<string>();
+  for (const raw of params.paths) {
+    if (typeof raw !== "string" || !raw.trim()) {
+      continue;
+    }
+    const canonical = await canonicalize(resolveFileToolPath(raw, params.cwd));
+    if (seen.has(canonical)) {
+      continue;
+    }
+    seen.add(canonical);
+    if (roots.some((root) => isInside(root, canonical))) {
+      continue;
+    }
+    outside.push(canonical);
+  }
+  return outside;
+}
+
+function ruleCovers(
+  rule: FileToolApprovalRule,
+  kind: FileToolApprovalKind,
+  filePath: string,
+): boolean {
+  if (rule.kind !== kind && !(rule.kind === "write" && kind === "read")) {
+    return false;
+  }
+  return isInside(rule.dir, filePath);
+}
+
+export function rulesCoverAll(
+  rules: readonly FileToolApprovalRule[],
+  kind: FileToolApprovalKind,
+  paths: readonly string[],
+): boolean {
+  return paths.every((filePath) => rules.some((rule) => ruleCovers(rule, kind, filePath)));
+}
+
+/** "Always" remembers the directory of each path, once each. */
+export function rulesAfterAllowAlways(
+  rules: readonly FileToolApprovalRule[],
+  kind: FileToolApprovalKind,
+  paths: readonly string[],
+  now: number,
+): FileToolApprovalRule[] {
+  const next = [...rules];
+  for (const filePath of paths) {
+    const dir = path.dirname(filePath);
+    if (next.some((rule) => rule.kind === kind && rule.dir === dir)) {
+      continue;
+    }
+    next.push({ kind, dir, createdAt: now });
+  }
+  return next;
+}
+
+export function buildFileAccessCommand(
+  kind: FileToolApprovalKind,
+  paths: readonly string[],
+): {
+  command: string;
+  commandArgv: string[];
+} {
+  return {
+    command: `${FILE_ACCESS_COMMAND_HEAD} ${kind} ${paths.join(" ")}`,
+    commandArgv: [FILE_ACCESS_COMMAND_HEAD, kind, ...paths],
+  };
+}
+
+function deniedResult(kind: FileToolApprovalKind, reason: string, paths: readonly string[]) {
+  const text = `File ${kind} denied (${reason}): ${paths.join(", ")}`;
+  return textResult(text, {
+    status: "denied",
+    kind,
+    reason,
+    paths: [...paths],
+  });
+}
+
+export type FileToolApprovalOutcome = { allowed: true } | { allowed: false; reason: string };
+
+/**
+ * Decide whether a call that touches `paths` may go ahead, asking when it
+ * must. Pure over its dependencies so the four cases are tested without a
+ * gateway or a disk.
+ */
+export async function decideFileToolAccess(
+  params: {
+    kind: FileToolApprovalKind;
+    paths: readonly string[];
+    context: FileToolApprovalContext;
+  },
+  deps: FileToolApprovalDependencies = defaultDependencies,
+): Promise<FileToolApprovalOutcome> {
+  const outside = await resolvePathsOutsideFreeRoots({
+    paths: params.paths,
+    cwd: params.context.cwd,
+    freeRoots: params.context.freeRoots,
+  });
+  if (outside.length === 0) {
+    return { allowed: true };
+  }
+
+  const host = deps.resolveHostPolicy({
+    agentId: params.context.agentId,
+    policy: params.context.policy,
+  });
+  if (host.security === "deny") {
+    return { allowed: false, reason: "security=deny" };
+  }
+  if (host.security === "full" && host.ask === "off") {
+    return { allowed: true };
+  }
+
+  const agentKey = params.context.agentId?.trim() || DEFAULT_AGENT_KEY;
+  const rules = deps.loadRules(agentKey);
+  if (host.ask !== "always" && rulesCoverAll(rules, params.kind, outside)) {
+    return { allowed: true };
+  }
+  if (host.ask === "off") {
+    // allowlist + off: nothing to ask with, and no rule says yes.
+    return { allowed: false, reason: "not allowed and ask=off" };
+  }
+
+  const { command, commandArgv } = buildFileAccessCommand(params.kind, outside);
+  const decision = await deps.requestDecision({
+    id: crypto.randomUUID(),
+    command,
+    commandArgv,
+    cwd: params.context.cwd,
+    host: "gateway",
+    security: host.security,
+    ask: host.ask,
+    agentId: params.context.agentId,
+    sessionKey: params.context.sessionKey,
+  });
+
+  if (decision === "allow-always") {
+    if (host.ask !== "always") {
+      deps.saveRules(agentKey, rulesAfterAllowAlways(rules, params.kind, outside, Date.now()));
+    }
+    return { allowed: true };
+  }
+  if (decision === "allow-once") {
+    return { allowed: true };
+  }
+  if (decision === null) {
+    // No answer before the request expired. The exec tool falls back to
+    // the approvals file's askFallback; `full` means proceed, else refuse.
+    return host.askFallback === "full"
+      ? { allowed: true }
+      : { allowed: false, reason: "approval-timeout" };
+  }
+  return { allowed: false, reason: "approval-denied" };
+}
+
+/** What a tool call would touch, from its arguments. */
+export type FileToolPathExtractor = (args: unknown, cwd: string) => string[];
+
+export function pathParamExtractor(keys: readonly string[] = ["path"]): FileToolPathExtractor {
+  return (args) => {
+    const record = getToolParamsRecord(args);
+    if (!record) {
+      return [];
+    }
+    const paths: string[] = [];
+    for (const key of keys) {
+      const value = record[key];
+      if (typeof value === "string" && value.trim()) {
+        paths.push(value);
+      }
+    }
+    return paths;
+  };
+}
+
+export const applyPatchPathExtractor: FileToolPathExtractor = (args, cwd) =>
+  extractApplyPatchTargetPaths(args, { cwd });
+
+export function wrapToolWithFileApproval(
+  tool: AnyAgentTool,
+  params: {
+    kind: FileToolApprovalKind;
+    context: FileToolApprovalContext;
+    extractPaths: FileToolPathExtractor;
+  },
+  deps: FileToolApprovalDependencies = defaultDependencies,
+): AnyAgentTool {
+  return {
+    ...tool,
+    execute: async (toolCallId, args, signal, onUpdate) => {
+      const paths = params.extractPaths(args, params.context.cwd);
+      const outcome = await decideFileToolAccess(
+        { kind: params.kind, paths, context: params.context },
+        deps,
+      );
+      if (!outcome.allowed) {
+        const outside = await resolvePathsOutsideFreeRoots({
+          paths,
+          cwd: params.context.cwd,
+          freeRoots: params.context.freeRoots,
+        });
+        return deniedResult(params.kind, outcome.reason, outside);
+      }
+      return tool.execute(toolCallId, args, signal, onUpdate);
+    },
+  };
+}
