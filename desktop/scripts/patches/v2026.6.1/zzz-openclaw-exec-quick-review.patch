index 00000000..3076df61
--- /dev/null
+++ b/src/agents/exec-quick-review.ts
@@ -0,0 +1,472 @@
+import os from "node:os";
+import path from "node:path";
+import type {
+  ExecAutoReviewDecision,
+  ExecAutoReviewer,
+  ExecAutoReviewInput,
+} from "../infra/exec-auto-review.js";
+
+/**
+ * The quick half of auto-review: what a person can decide from the
+ * command alone, decided without a model round trip.
+ *
+ * Auto mode sends every command the allowlist does not cover to the
+ * model-backed reviewer (`exec-auto-reviewer.ts`), which costs a request
+ * and a few seconds each time. Most commands do not need it: `ls`,
+ * `cat`, `mkdir`, a script in the working folder are everyday, and `rm
+ * -rf`, `sudo`, `curl | sh`, a read of `~/.ssh` are never fine to run
+ * unasked. This decides those two ends deterministically and leaves the
+ * middle to the model. The person is asked about the risky end with a
+ * sentence they can read, not a risk score.
+ *
+ * Deliberately conservative in one direction only: an "allow" here
+ * requires every segment of a pipeline to be everyday and every path
+ * to be ordinary; one doubtful segment and the whole command goes to the
+ * model or to the person.
+ */
+
+const READ_ONLY_BINS = new Set([
+  "ls",
+  "pwd",
+  "cat",
+  "head",
+  "tail",
+  "less",
+  "more",
+  "wc",
+  "grep",
+  "rg",
+  "egrep",
+  "fgrep",
+  "stat",
+  "file",
+  "which",
+  "whereis",
+  "type",
+  "echo",
+  "printf",
+  "date",
+  "cal",
+  "whoami",
+  "id",
+  "uname",
+  "hostname",
+  "df",
+  "du",
+  "ps",
+  "tree",
+  "diff",
+  "cmp",
+  "sort",
+  "uniq",
+  "cut",
+  "tr",
+  "awk",
+  "sed",
+  "jq",
+  "yq",
+  "basename",
+  "dirname",
+  "realpath",
+  "readlink",
+  "md5",
+  "md5sum",
+  "shasum",
+  "sha256sum",
+  "sw_vers",
+  "sysctl",
+  "true",
+  "false",
+  "test",
+  "[",
+  "sleep",
+  "mdls",
+  "mdfind",
+  "plutil",
+  "column",
+  "nl",
+  "tac",
+  "rev",
+  "xargs",
+  "open",
+]);
+
+/** Everyday work inside the person's own folders. */
+const EVERYDAY_WRITE_BINS = new Set([
+  "mkdir",
+  "touch",
+  "cp",
+  "mv",
+  "ln",
+  "unzip",
+  "zip",
+  "tar",
+  "gzip",
+  "gunzip",
+  "python",
+  "python3",
+  "node",
+  "npm",
+  "npx",
+  "pnpm",
+  "yarn",
+  "bun",
+  "deno",
+  "uv",
+  "uvx",
+  "pip",
+  "pip3",
+  "ruby",
+  "perl",
+  "swift",
+  "go",
+  "cargo",
+  "make",
+  "tsc",
+  "tee",
+  "pandoc",
+  "libreoffice",
+  "soffice",
+  "qlmanage",
+  "sips",
+  "textutil",
+  "ffmpeg",
+  "convert",
+  "magick",
+  "pdftotext",
+  "osascript",
+  "say",
+  "pbcopy",
+  "pbpaste",
+  "brew",
+]);
+
+/** Read-only git. Anything else in git goes to the model. */
+const GIT_READ_ONLY = new Set([
+  "status",
+  "log",
+  "diff",
+  "show",
+  "branch",
+  "remote",
+  "fetch",
+  "blame",
+  "describe",
+  "rev-parse",
+  "ls-files",
+  "stash",
+]);
+
+type Rule = { test: RegExp; reason: string };
+
+/** Never run unasked. The reason is the sentence on the card. */
+const DESTRUCTIVE_RULES: readonly Rule[] = [
+  { test: /(^|[\s;&|(])(sudo|doas|su)\b/u, reason: "Runs with administrator rights." },
+  {
+    test: /(^|[\s;&|(])rm\s+(?:-[a-zA-Z]*[rR][a-zA-Z]*|--recursive)\b/u,
+    reason: "Deletes a whole folder and everything in it.",
+  },
+  {
+    test: /(^|[\s;&|(])rm\s+(?:-\S+\s+)*(?:\/|~|\$HOME|\*|\.\s*$|\.\/\*)/u,
+    reason: "Deletes at the top of a folder tree.",
+  },
+  {
+    test: /(^|[\s;&|(])(mkfs|diskutil\s+(erase|partition|reformat)|dd\b|fdisk|format)\b/u,
+    reason: "Rewrites a disk.",
+  },
+  {
+    test: /(^|[\s;&|(])(chmod|chown|chgrp)\s+(?:-[a-zA-Z]*R|.*\b[0-7]?777\b)/u,
+    reason: "Changes ownership or permissions across a folder tree.",
+  },
+  {
+    test: /\b(curl|wget|fetch)\b[^|]*\|\s*(sudo\s+)?(sh|bash|zsh|python[0-9.]*|node|perl|ruby)\b/u,
+    reason: "Downloads a script and runs it straight away.",
+  },
+  {
+    test: /\bbase64\s+(-d|--decode)[^|]*\|\s*(sh|bash|zsh|python[0-9.]*|node)\b/u,
+    reason: "Runs a command hidden in encoded text.",
+  },
+  { test: /(^|[\s;&|(])eval\b/u, reason: "Builds and runs a command from text." },
+  {
+    test: /\bgit\s+push\b.*(\s--force\b|\s-f\b|\s--force-with-lease\b)/u,
+    reason: "Overwrites history on a shared repository.",
+  },
+  {
+    test: /\bgit\s+(reset\s+--hard|clean\s+-[a-zA-Z]*[fdx]|branch\s+-D|checkout\s+--\s+\.|restore\s+\.)/u,
+    reason: "Throws away uncommitted work.",
+  },
+  {
+    test: /\b(npm|pnpm|yarn)\s+publish\b|\btwine\s+upload\b|\bgh\s+release\s+create\b|\bcargo\s+publish\b/u,
+    reason: "Publishes to the world.",
+  },
+  { test: /(^|[\s;&|(])(kill\s+-9\s+-1|killall|pkill)\b/u, reason: "Stops running programs." },
+  {
+    test: /(^|[\s;&|(])(launchctl|systemctl|shutdown|reboot|halt|poweroff)\b/u,
+    reason: "Changes what runs at start-up, or turns the computer off.",
+  },
+  { test: /\bcrontab\s+-r\b/u, reason: "Removes every scheduled job." },
+  { test: /(^|[\s;&|(])defaults\s+(write|delete)\b/u, reason: "Changes a system setting." },
+  { test: /(^|[\s;&|(])security\b/u, reason: "Reaches the keychain." },
+  {
+    test: /\bosascript\b.*\b(keystroke|System Events|delete|do shell script)\b/u,
+    reason: "Drives the computer through automation.",
+  },
+  { test: /(^|[\s;&|(])(ssh|scp|sftp|rsync)\b.*@/u, reason: "Reaches another computer." },
+  {
+    test: /(^|[\s;&|(])(env|printenv|export\s+-p)\s*(\||$|;|>)/u,
+    reason: "Prints every secret in the environment.",
+  },
+  { test: /(^|[\s;&|(])(nc|ncat|netcat|socat)\b/u, reason: "Opens a network connection by hand." },
+  {
+    test: /\b(csrutil|spctl\s+--master-disable|tccutil|xattr\s+-d\s+com\.apple\.quarantine|chflags)\b/u,
+    reason: "Turns off a protection of the operating system.",
+  },
+  {
+    test: /\bhistory\s+-c\b|>\s*~?\/?\S*\.(zsh|bash)_history\b/u,
+    reason: "Erases the command history.",
+  },
+  { test: /\bgit\s+config\s+--global\b/u, reason: "Changes git for every project." },
+];
+
+const SENSITIVE_SEGMENTS: readonly {
+  test: (rel: string, base: string) => boolean;
+  reason: string;
+}[] = [
+  { test: (rel) => /^\.ssh(\/|$)/u.test(rel), reason: "the SSH keys" },
+  { test: (rel) => /^\.aws(\/|$)/u.test(rel), reason: "the cloud credentials" },
+  { test: (rel) => /^\.gnupg(\/|$)/u.test(rel), reason: "the encryption keys" },
+  { test: (rel) => /^\.config\/gcloud(\/|$)/u.test(rel), reason: "the cloud credentials" },
+  { test: (rel) => /^\.kube(\/|$)/u.test(rel), reason: "the cluster credentials" },
+  { test: (rel) => /^\.docker\/config\.json$/u.test(rel), reason: "the registry credentials" },
+  {
+    test: (rel) => /^\.npmrc$|^\.pypirc$|^\.netrc$|^\.git-credentials$/u.test(rel),
+    reason: "a saved login",
+  },
+  { test: (rel) => /^Library\/Keychains(\/|$)/u.test(rel), reason: "the keychain" },
+  { test: (rel) => /^Library\/Cookies(\/|$)/u.test(rel), reason: "the browser cookies" },
+  {
+    test: (rel) =>
+      /^Library\/Application Support\/(Google\/Chrome|Firefox|BraveSoftware|Arc)(\/|$)/u.test(rel),
+    reason: "a browser's saved data",
+  },
+  { test: (rel) => /(^|\/)\.env(\.[^/]+)?$/u.test(rel), reason: "a file of secrets" },
+  {
+    test: (_rel, base) =>
+      /\.(pem|key|p12|pfx)$/u.test(base) || /^id_(rsa|ed25519|ecdsa|dsa)(\.pub)?$/u.test(base),
+    reason: "a private key",
+  },
+  {
+    test: (_rel, base) => /^(credentials|secrets?)(\.[a-z]+)?$/iu.test(base),
+    reason: "a credentials file",
+  },
+  {
+    test: (rel) => /^\.(zsh|bash)_history$|^\.zsh_sessions(\/|$)/u.test(rel),
+    reason: "the command history",
+  },
+];
+
+/** Outside the home folder: the operating system's own, and the root. */
+const SYSTEM_ROOTS = [
+  "/etc",
+  "/System",
+  "/usr",
+  "/bin",
+  "/sbin",
+  "/Library",
+  "/private/etc",
+  "/private/var",
+  "/var",
+  "/boot",
+  "/dev",
+  "/proc",
+  "/sys",
+];
+
+const SHELL_SEGMENT_SPLIT = /\s*(?:\|\||&&|;|\|)\s*/u;
+
+function firstWord(segment: string): string {
+  const words = segment.trim().split(/\s+/u);
+  // `VAR=value cmd` and a leading `command` / `exec` / `time` wrapper.
+  let index = 0;
+  while (index < words.length && /^[A-Za-z_][A-Za-z0-9_]*=/u.test(words[index] ?? "")) {
+    index += 1;
+  }
+  const word = words[index] ?? "";
+  return path.basename(word);
+}
+
+function segmentArgs(segment: string): string[] {
+  return segment
+    .trim()
+    .split(/\s+/u)
+    .slice(1)
+    .filter((word) => !word.startsWith("-"));
+}
+
+/** A word worth resolving as a path: one with a separator, or a name that is sensitive on its own. */
+function looksLikePath(word: string): boolean {
+  return (
+    word.startsWith("/") ||
+    word.startsWith("~") ||
+    word.startsWith("$HOME") ||
+    word.includes("/") ||
+    /^\.env(\.|$)|\.(pem|key|p12|pfx)$|^id_(rsa|ed25519|ecdsa|dsa)(\.pub)?$|^(credentials|secrets?)(\.[a-z]+)?$/iu.test(
+      word,
+    )
+  );
+}
+
+/** Installing, removing or upgrading packages is the model's call, not everyday. */
+const PACKAGE_MANAGERS = new Set([
+  "npm",
+  "pnpm",
+  "yarn",
+  "bun",
+  "uv",
+  "pip",
+  "pip3",
+  "cargo",
+  "go",
+  "gem",
+  "brew",
+]);
+const PACKAGE_CHANGE =
+  /^(install|i|add|remove|rm|uninstall|update|upgrade|link|unlink|global|tool)$/u;
+
+/**
+ * Why a path is not an everyday one, in the words the card uses, or
+ * undefined for an ordinary file. `home` is injectable for tests.
+ */
+export function sensitivePathReason(
+  rawPath: string,
+  options: { home?: string; cwd?: string } = {},
+): string | undefined {
+  const home = options.home ?? os.homedir();
+  const expanded = rawPath.replace(/^~(?=\/|$)/u, home).replace(/^\$HOME(?=\/|$)/u, home);
+  const absolute = path.isAbsolute(expanded)
+    ? path.normalize(expanded)
+    : path.resolve(options.cwd ?? home, expanded);
+  const base = path.basename(absolute);
+  const relativeToHome = path.relative(home, absolute);
+  const insideHome =
+    relativeToHome !== "" && !relativeToHome.startsWith("..") && !path.isAbsolute(relativeToHome);
+  if (insideHome) {
+    for (const rule of SENSITIVE_SEGMENTS) {
+      if (rule.test(relativeToHome, base)) {
+        return `Touches ${rule.reason}.`;
+      }
+    }
+    return undefined;
+  }
+  if (absolute === home) {
+    return undefined;
+  }
+  if (SYSTEM_ROOTS.some((root) => absolute === root || absolute.startsWith(`${root}/`))) {
+    return "Touches the operating system's own files.";
+  }
+  if (absolute === "/") {
+    return "Touches the top of the disk.";
+  }
+  // Somewhere else on the disk (an external drive, /opt, another user):
+  // not sensitive by name, but not everyday either.
+  for (const rule of SENSITIVE_SEGMENTS) {
+    if (rule.test(base, base)) {
+      return `Touches ${rule.reason}.`;
+    }
+  }
+  return undefined;
+}
+
+function firstSensitivePath(
+  words: readonly string[],
+  cwd: string | null | undefined,
+): string | undefined {
+  for (const word of words) {
+    if (!looksLikePath(word)) {
+      continue;
+    }
+    const reason = sensitivePathReason(word, { cwd: cwd ?? undefined });
+    if (reason) {
+      return reason;
+    }
+  }
+  return undefined;
+}
+
+function reviewSegment(segment: string, cwd: string | null | undefined): "allow" | "model" {
+  const bin = firstWord(segment);
+  if (!bin) {
+    return "model";
+  }
+  const args = segmentArgs(segment);
+  if (bin === "git") {
+    return GIT_READ_ONLY.has(args[0] ?? "") ? "allow" : "model";
+  }
+  if (bin === "find" && /\s-(delete|exec|execdir|ok)\b/u.test(segment)) {
+    return "model";
+  }
+  if (bin === "open" && /\s-a\b/u.test(segment)) {
+    // Opening an application is the model's call; opening a file is not.
+    return "model";
+  }
+  if (bin === "osascript" || bin === "brew") {
+    return "model";
+  }
+  if (PACKAGE_MANAGERS.has(bin) && PACKAGE_CHANGE.test(args[0] ?? "")) {
+    return "model";
+  }
+  if (!READ_ONLY_BINS.has(bin) && !EVERYDAY_WRITE_BINS.has(bin)) {
+    return "model";
+  }
+  // A redirection or an argument into somewhere sensitive is never everyday.
+  const targets = segment.split(/\s+/u).map((word) => word.replace(/^[<>]+/u, ""));
+  if (firstSensitivePath(targets, cwd)) {
+    return "model";
+  }
+  return "allow";
+}
+
+/**
+ * The quick decision, or undefined when the command is the model's to
+ * judge. Never returns "allow" for a command any rule flags.
+ */
+export function quickExecReview(input: ExecAutoReviewInput): ExecAutoReviewDecision | undefined {
+  const command = input.command.trim();
+  if (!command) {
+    return undefined;
+  }
+  for (const rule of DESTRUCTIVE_RULES) {
+    if (rule.test.test(command)) {
+      return { decision: "ask", risk: "high", rationale: rule.reason };
+    }
+  }
+  const sensitive = firstSensitivePath(
+    command.split(/\s+/u).map((word) => word.replace(/^[<>]+/u, "")),
+    input.cwd,
+  );
+  if (sensitive) {
+    return { decision: "ask", risk: "high", rationale: sensitive };
+  }
+  if (!input.analysis.parsed || input.analysis.heredoc || input.analysis.inlineEval) {
+    // Not something this can read whole; the model gets it.
+    return undefined;
+  }
+  const segments = command.split(SHELL_SEGMENT_SPLIT).filter(Boolean);
+  if (segments.length === 0) {
+    return undefined;
+  }
+  const verdicts = segments.map((segment) => reviewSegment(segment, input.cwd));
+  if (verdicts.every((verdict) => verdict === "allow")) {
+    return {
+      decision: "allow-once",
+      risk: "low",
+      rationale: "Everyday command in the person's own folders.",
+    };
+  }
+  return undefined;
+}
+
+/** The quick decision first; the given reviewer for whatever is left. */
+export function withQuickExecReview(next: ExecAutoReviewer): ExecAutoReviewer {
+  return async (input) => quickExecReview(input) ?? (await next(input));
+}
diff --git a/src/agents/exec-quick-review.test.ts b/src/agents/exec-quick-review.test.ts
new file mode 100644
index 00000000..ba1c1127
