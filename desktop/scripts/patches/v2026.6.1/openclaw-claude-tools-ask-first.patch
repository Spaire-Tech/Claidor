+      ],
+      [
+        "Edit",
+        { file_path: "/Users/bass/Work/a.ts", old_string: "a", new_string: "b" },
+        "/Users/bass/Work/a.ts",
+      ],
+      ["MultiEdit", { file_path: "/Users/bass/Work/b.ts", edits: [] }, "/Users/bass/Work/b.ts"],
+      ["NotebookEdit", { notebook_path: "/Users/bass/Work/n.ipynb" }, "/Users/bass/Work/n.ipynb"],
+    ];
+    for (const [toolName, input, expected] of cases) {
+      await decideClaudeNativeToolUse({ request: { toolName, input }, context: context() }, d.deps);
+      const call = vi.mocked(d.deps.decideFileAccess).mock.calls.at(-1)?.[0];
