index 00000000..873dd69e
--- /dev/null
+++ b/src/agents/cli-runner/claude-native-tool-approval.ts
@@ -0,0 +1,397 @@
+import crypto from "node:crypto";
+import {
+  evaluateShellAllowlist,
+  resolveSafeBins,
+  type ExecAllowlistAnalysis,
+} from "../../infra/exec-approvals-allowlist.js";
+import {
+  addDurableCommandApproval,
+  hasDurableExecApproval,
+  maxAsk,
+  minSecurity,
+  persistAllowAlwaysPatterns,
+  recordAllowlistMatchesUse,
+  requiresExecApproval,
+  resolveExecApprovals,
+  type ExecAsk,
+  type ExecSecurity,
+} from "../../infra/exec-approvals.js";
+import { resolveSafeBinProfiles } from "../../infra/exec-safe-bin-policy-profiles.js";
+import type { RequestExecApprovalDecisionParams } from "../bash-tools.exec-approval-request.js";
+import {
+  decideFileToolAccess,
+  type FileToolApprovalContext,
+  type FileToolApprovalKind,
+} from "../file-tool-approval.js";
+
+/**
+ * Claude Code's own tools ask through the gateway's approval.
+ *
+ * A Claude live session runs Claude Code with `--permission-prompt-tool
+ * stdio`, so every tool Claude Code would itself prompt for — `Bash`,
+ * `Write`, `Edit`, a `Read` outside the working directory, `WebFetch` —
+ * arrives here as a `can_use_tool` control request. The stock engine answered
+ * it from the exec policy alone: allow under `full`/`off`, deny everything
+ * else outright. That leaves no middle: either nothing on the computer is
+ * ever asked about, or nothing on the computer can be done at all.
+ *
+ * This module gives those requests the answer the engine's own tools get:
+ *
+ * - `Bash` is a command, judged as the `exec` tool judges one — the same
+ *   approvals file, the same allowlist analysis, the same card, and "always"
+ *   remembered the same way.
+ * - `Read`, `Glob`, `Grep` are reads and `Write`, `Edit`, `MultiEdit`,
+ *   `NotebookEdit` are writes, judged as the patched file tools are
+ *   (`file-tool-approval.ts`): free inside the agent's own roots, asked
+ *   everywhere else, with "always" remembered per directory.
+ * - Anything else — `WebFetch`, `WebSearch`, a tool that does not exist yet —
+ *   is asked about as itself, tool name and arguments on the card. Denying
+ *   silently would teach the model that the computer is broken; allowing
+ *   silently would break the rule that everything asks first.
+ *
+ * The request is marked with the `claude-tool` argv head so a client can
+ * tell it from a shell command raised by `exec`. Like a file access, the
+ * caller is blocked on the answer inside the turn: a client must not send
+ * the "approved, carry on" continuation an `exec` approval needs.
+ *
+ * Pure over its dependencies so every branch is tested without a gateway,
+ * an approvals file or a disk.
+ */
+
+export const CLAUDE_TOOL_COMMAND_HEAD = "claude-tool";
+
+const BASH_TOOL = "Bash";
+const FILE_READ_TOOLS: Readonly<Record<string, readonly string[]>> = {
+  Read: ["file_path"],
+  Glob: ["path"],
+  Grep: ["path"],
+  LS: ["path"],
+};
+const FILE_WRITE_TOOLS: Readonly<Record<string, readonly string[]>> = {
+  Write: ["file_path"],
+  Edit: ["file_path"],
+  MultiEdit: ["file_path"],
+  NotebookEdit: ["notebook_path"],
+};
+const MAX_CARD_TEXT_CHARS = 2_000;
+
+export type ClaudeNativeToolPolicy = {
+  security: ExecSecurity;
+  ask: ExecAsk;
+};
+
+export type ClaudeNativeToolContext = {
+  agentId?: string;
+  sessionKey?: string;
+  /** Where Claude Code runs; relative paths resolve here. */
+  cwd: string;
+  /** The agent's own workspace: free for file tools. */
+  workspaceDir: string;
+  policy: ClaudeNativeToolPolicy;
+};
+
+export type ClaudeNativeToolRequest = {
+  toolName: string;
+  input: unknown;
+};
+
+export type ClaudeNativeToolDecision =
+  | { behavior: "allow" }
+  | { behavior: "deny"; message: string };
+
+export type ClaudeNativeToolDependencies = {
+  requestDecision: (params: RequestExecApprovalDecisionParams) => Promise<string | null>;
+  decideFileAccess: (params: {
+    kind: FileToolApprovalKind;
+    paths: readonly string[];
+    context: FileToolApprovalContext;
+  }) => Promise<{ allowed: true } | { allowed: false; reason: string }>;
+  /** The `exec` tool's view of the policy for this agent: config tightened by the file. */
+  resolveHostPolicy: (params: { agentId?: string; policy: ClaudeNativeToolPolicy }) => {
+    security: ExecSecurity;
+    ask: ExecAsk;
+    askFallback: ExecSecurity;
+  };
+  /** Whether a command needs no card: allowlisted, or answered "always" before. */
+  evaluateCommand: (params: {
+    command: string;
+    cwd: string;
+    agentId?: string;
+    policy: ClaudeNativeToolPolicy;
+    /** A shell command gets the exec tool's allowlist analysis; a tool call does not. */
+    shell: boolean;
+  }) => ClaudeNativeCommandEvaluation;
+};
+
+export type ClaudeNativeCommandEvaluation = {
+  analysisOk: boolean;
+  allowlistSatisfied: boolean;
+  durableApprovalSatisfied: boolean;
+  /** Remember an "always" for this command. */
+  rememberAlways: () => void;
+  /** Note that an allowlist entry was used. */
+  recordUse: () => void;
+};
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return Boolean(value) && typeof value === "object" && !Array.isArray(value);
+}
+
+function readStrings(input: unknown, keys: readonly string[]): string[] {
+  if (!isRecord(input)) {
+    return [];
+  }
+  const out: string[] = [];
+  for (const key of keys) {
+    const value = input[key];
+    if (typeof value === "string" && value.trim()) {
+      out.push(value);
+    }
+  }
+  return out;
+}
+
+/** What the card shows for a tool that is neither a command nor a file. */
+export function describeClaudeToolCall(toolName: string, input: unknown): string {
+  let args = "";
+  if (isRecord(input) && Object.keys(input).length > 0) {
+    try {
+      args = JSON.stringify(input);
+    } catch {
+      args = "";
+    }
+  } else if (typeof input === "string") {
+    args = input;
+  }
+  const text = args ? `${toolName} ${args}` : toolName;
+  return text.length > MAX_CARD_TEXT_CHARS ? `${text.slice(0, MAX_CARD_TEXT_CHARS)}…` : text;
+}
+
+export function buildClaudeToolCommand(
+  toolName: string,
+  text: string,
+): { command: string; commandArgv: string[] } {
+  return {
+    command: text,
+    commandArgv: [CLAUDE_TOOL_COMMAND_HEAD, toolName, text],
+  };
+}
+
+function deny(message: string): ClaudeNativeToolDecision {
+  return { behavior: "deny", message };
+}
+
+const ALLOW: ClaudeNativeToolDecision = { behavior: "allow" };
+
+function evaluateCommandOnHost(
+  params: Parameters<ClaudeNativeToolDependencies["evaluateCommand"]>[0],
+): ClaudeNativeCommandEvaluation {
+  const approvals = resolveExecApprovals(params.agentId, {
+    security: params.policy.security,
+    ask: params.policy.ask,
+  });
+  const analysis: ExecAllowlistAnalysis | null = params.shell
+    ? evaluateShellAllowlist({
+        command: params.command,
+        allowlist: approvals.allowlist,
+        safeBins: resolveSafeBins(),
+        safeBinProfiles: resolveSafeBinProfiles(),
+        cwd: params.cwd,
+        env: process.env,
+        platform: process.platform,
+      })
+    : null;
+  const analysisOk = analysis?.analysisOk === true;
+  return {
+    analysisOk,
+    allowlistSatisfied: analysisOk && analysis?.allowlistSatisfied === true,
+    durableApprovalSatisfied: hasDurableExecApproval({
+      analysisOk,
+      segmentAllowlistEntries: analysis?.segmentAllowlistEntries ?? [],
+      allowlist: approvals.allowlist,
+      commandText: params.command,
+    }),
+    rememberAlways: () => {
+      const patterns = analysis
+        ? persistAllowAlwaysPatterns({
+            approvals: approvals.file,
+            agentId: params.agentId,
+            segments: analysis.segments,
+            cwd: params.cwd,
+            env: process.env,
+            platform: process.platform,
+          })
+        : [];
+      if (patterns.length === 0) {
+        addDurableCommandApproval(approvals.file, params.agentId, params.command);
+      }
+    },
+    recordUse: () => {
+      if (!analysis) {
+        return;
+      }
+      recordAllowlistMatchesUse({
+        approvals: approvals.file,
+        agentId: params.agentId,
+        matches: analysis.allowlistMatches,
+        command: params.command,
+      });
+    },
+  };
+}
+
+const defaultDependencies: ClaudeNativeToolDependencies = {
+  requestDecision: async (params) => {
+    const { requestExecApprovalDecision } = await import("../file-tool-approval.runtime.js");
+    return await requestExecApprovalDecision(params);
+  },
+  decideFileAccess: (params) => decideFileToolAccess(params),
+  resolveHostPolicy: (params) => {
+    const approvals = resolveExecApprovals(params.agentId, {
+      security: params.policy.security,
+      ask: params.policy.ask,
+    });
+    const security = minSecurity(params.policy.security, approvals.agent.security);
+    const ask = maxAsk(params.policy.ask, approvals.agent.ask);
+    return { security, ask, askFallback: minSecurity(security, approvals.agent.askFallback) };
+  },
+  evaluateCommand: evaluateCommandOnHost,
+};
+
+async function decideCommand(
+  params: {
+    toolName: string;
+    text: string;
+    shell: boolean;
+    context: ClaudeNativeToolContext;
+  },
+  deps: ClaudeNativeToolDependencies,
+): Promise<ClaudeNativeToolDecision> {
+  const host = deps.resolveHostPolicy({
+    agentId: params.context.agentId,
+    policy: params.context.policy,
+  });
+  if (host.security === "deny") {
+    return deny(`Caisra's policy denies ${params.toolName} (security=deny).`);
+  }
+  if (host.security === "full" && host.ask === "off") {
+    return ALLOW;
+  }
+  const evaluation = deps.evaluateCommand({
+    command: params.text,
+    cwd: params.context.cwd,
+    agentId: params.context.agentId,
+    policy: { security: host.security, ask: host.ask },
+    shell: params.shell,
+  });
+  const requiresAsk = requiresExecApproval({
+    ask: host.ask,
+    security: host.security,
+    analysisOk: evaluation.analysisOk,
+    allowlistSatisfied: evaluation.allowlistSatisfied,
+    durableApprovalSatisfied: evaluation.durableApprovalSatisfied,
+  });
+  if (!requiresAsk) {
+    if (
+      host.security === "allowlist" &&
+      !evaluation.allowlistSatisfied &&
+      !evaluation.durableApprovalSatisfied
+    ) {
+      // allowlist + off: nothing to ask with, and nothing says yes.
+      return deny(`${params.toolName} is not on Caisra's allowlist and asking is off.`);
+    }
+    evaluation.recordUse();
+    return ALLOW;
+  }
+
+  const { command, commandArgv } = buildClaudeToolCommand(params.toolName, params.text);
+  const decision = await deps.requestDecision({
+    id: crypto.randomUUID(),
+    command,
+    commandArgv,
+    cwd: params.context.cwd,
+    host: "gateway",
+    security: host.security,
+    ask: host.ask,
+    agentId: params.context.agentId,
+    sessionKey: params.context.sessionKey,
+  });
+  if (decision === "allow-always") {
+    if (host.ask !== "always") {
+      evaluation.rememberAlways();
+    }
+    return ALLOW;
+  }
+  if (decision === "allow-once") {
+    return ALLOW;
+  }
+  if (decision === null) {
+    // No answer before the request expired: the exec tool's askFallback rule.
+    return host.askFallback === "full"
+      ? ALLOW
+      : deny(`Nobody answered the request to run ${params.toolName} in time.`);
+  }
+  return deny(`The person did not allow ${params.toolName}.`);
+}
+
+/**
+ * Answer one `can_use_tool` request. Never throws: a failure inside the
+ * approval machinery is a denial with the reason, so Claude Code can say so
+ * instead of hanging on an unanswered request.
+ */
+export async function decideClaudeNativeToolUse(
+  params: { request: ClaudeNativeToolRequest; context: ClaudeNativeToolContext },
+  deps: ClaudeNativeToolDependencies = defaultDependencies,
+): Promise<ClaudeNativeToolDecision> {
+  const { toolName, input } = params.request;
+  try {
+    if (toolName === BASH_TOOL) {
+      const command = readStrings(input, ["command"])[0]?.trim() ?? "";
+      if (!command) {
+        return deny("Bash was asked to run an empty command.");
+      }
+      return await decideCommand(
+        { toolName, text: command, shell: true, context: params.context },
+        deps,
+      );
+    }
+    const fileKind: FileToolApprovalKind | null =
+      toolName in FILE_WRITE_TOOLS ? "write" : toolName in FILE_READ_TOOLS ? "read" : null;
+    if (fileKind) {
+      const keys = fileKind === "write" ? FILE_WRITE_TOOLS[toolName] : FILE_READ_TOOLS[toolName];
+      const paths = readStrings(input, keys ?? []);
+      // Glob and Grep with no path search the working directory itself.
+      const outcome = await deps.decideFileAccess({
+        kind: fileKind,
+        paths: paths.length > 0 ? paths : [params.context.cwd],
+        context: {
+          agentId: params.context.agentId,
+          sessionKey: params.context.sessionKey,
+          cwd: params.context.cwd,
+          // Only the agent's own workspace is free. The engine's state dir
+          // beside it holds the config, the credentials, the sessions and
+          // every other agent's workspace; on 16 September an agent read
+          // its way through the app's own installation without a card and
+          // told the person what the app was forked from.
+          freeRoots: [params.context.workspaceDir],
+          policy: params.context.policy,
+        },
+      });
+      return outcome.allowed
+        ? ALLOW
+        : deny(`File ${fileKind} by ${toolName} was not allowed (${outcome.reason}).`);
+    }
+    return await decideCommand(
+      {
+        toolName,
+        text: describeClaudeToolCall(toolName, input),
+        shell: false,
+        context: params.context,
+      },
+      deps,
+    );
+  } catch (error) {
+    const message = error instanceof Error ? error.message : String(error);
+    return deny(`Caisra could not ask about ${toolName}: ${message}`);
+  }
+}
