@@ -0,0 +1,365 @@
+import { describe, expect, it, vi } from "vitest";
+import {
+  buildClaudeToolCommand,
+  CLAUDE_TOOL_COMMAND_HEAD,
+  decideClaudeNativeToolUse,
+  describeClaudeToolCall,
+  type ClaudeNativeToolDependencies,
+} from "./claude-native-tool-approval.js";
+
+const context = (
+  overrides: Partial<Parameters<typeof decideClaudeNativeToolUse>[0]["context"]> = {},
+) => ({
+  agentId: "main",
+  sessionKey: "agent:main:main",
+  cwd: "/Users/bass/Work",
+  workspaceDir: "/state/workspace-main",
+  policy: { security: "allowlist" as const, ask: "on-miss" as const },
+  ...overrides,
+});
+
+type Evaluation = ReturnType<ClaudeNativeToolDependencies["evaluateCommand"]>;
+
+function deps(
+  overrides: Partial<ClaudeNativeToolDependencies> = {},
+  evaluation: Partial<Evaluation> = {},
+) {
+  const rememberAlways = vi.fn();
+  const recordUse = vi.fn();
+  const built: ClaudeNativeToolDependencies = {
+    requestDecision: vi.fn(async () => "allow-once" as string | null),
+    decideFileAccess: vi.fn(async () => ({ allowed: true as const })),
+    stateDir: () => "/state",
+    resolveHostPolicy: vi.fn(({ policy }) => ({ ...policy, askFallback: "deny" as const })),
+    evaluateCommand: vi.fn(() => ({
+      analysisOk: true,
+      allowlistSatisfied: false,
+      durableApprovalSatisfied: false,
+      rememberAlways,
+      recordUse,
+      ...evaluation,
+    })),
+    ...overrides,
+  };
+  return { deps: built, rememberAlways, recordUse };
+}
+
+describe("a Bash command from Claude Code", () => {
+  it("asks through the command approval, marked as Claude's own tool", async () => {
+    const d = deps();
+    const decision = await decideClaudeNativeToolUse(
+      {
+        request: { toolName: "Bash", input: { command: "ls -la ~/Documents" } },
+        context: context(),
+      },
+      d.deps,
+    );
+    expect(decision).toEqual({ behavior: "allow" });
+    const request = vi.mocked(d.deps.requestDecision).mock.calls[0]?.[0];
+    expect(request?.command).toBe("ls -la ~/Documents");
+    expect(request?.commandArgv).toEqual([CLAUDE_TOOL_COMMAND_HEAD, "Bash", "ls -la ~/Documents"]);
+    expect(request?.cwd).toBe("/Users/bass/Work");
+    expect(request?.agentId).toBe("main");
+    expect(request?.sessionKey).toBe("agent:main:main");
+    expect(request?.host).toBe("gateway");
+  });
+
+  it("is denied when the person says no, with the reason for the model", async () => {
+    const d = deps({ requestDecision: vi.fn(async () => "deny") });
+    const decision = await decideClaudeNativeToolUse(
+      { request: { toolName: "Bash", input: { command: "rm -rf build" } }, context: context() },
+      d.deps,
+    );
+    expect(decision.behavior).toBe("deny");
+    expect(decision.behavior === "deny" && decision.message).toContain("did not allow Bash");
+  });
+
+  it("runs without a card when the allowlist already says yes", async () => {
+    const d = deps({}, { allowlistSatisfied: true });
+    const decision = await decideClaudeNativeToolUse(
+      { request: { toolName: "Bash", input: { command: "git status" } }, context: context() },
+      d.deps,
+    );
+    expect(decision).toEqual({ behavior: "allow" });
+    expect(d.deps.requestDecision).not.toHaveBeenCalled();
+    expect(d.recordUse).toHaveBeenCalledTimes(1);
+  });
+
+  it("runs without a card when an earlier always covers it", async () => {
+    const d = deps({}, { durableApprovalSatisfied: true });
+    const decision = await decideClaudeNativeToolUse(
+      { request: { toolName: "Bash", input: { command: "open -a Notes" } }, context: context() },
+      d.deps,
+    );
+    expect(decision).toEqual({ behavior: "allow" });
+    expect(d.deps.requestDecision).not.toHaveBeenCalled();
+  });
+
+  it("remembers an always", async () => {
+    const d = deps({ requestDecision: vi.fn(async () => "allow-always") });
+    await decideClaudeNativeToolUse(
+      { request: { toolName: "Bash", input: { command: "open -a Notes" } }, context: context() },
+      d.deps,
+    );
+    expect(d.rememberAlways).toHaveBeenCalledTimes(1);
+  });
+
