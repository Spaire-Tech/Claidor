{
 "part": "packages/git-core",
 "surface": {
  "diagnostics": {
   "appendGitDiagnostics": "function"
  },
  "exec": {
   "gitExecFile": "function"
  },
  "env": {
   "createGitProcessEnv": "function"
  },
  "redaction": {
   "redactHttpUrlUserinfo": "function"
  }
 },
 "scenarios": {
  "a failure's code and exit code are added to its message, once": {
   "returned": [
    "clone failed [git: gitErrorCode=NotAGitRepository exitCode=128]",
    "clone failed [git: exitCode=1]",
    "clone failed",
    "clone failed [git: exitCode=1]",
    "clone failed",
    "clone failed",
    "clone failed",
    "clone failed [git: exitCode=128]"
   ]
  },
  "git's own words are added when asked, cut at 2,048 and with sign-ins taken out of addresses": {
   "returned": [
    "push failed [git: exitCode=1]\n--- git stderr ---\nfatal: unable to access 'https://example.com/a/b.git/': 403",
    "push failed [git: exitCode=1]",
    "push failed [git: exitCode=1]",
    2097,
    "xxxxxxxxxxxxx… [truncated to 2048 chars]",
    "push failed [git: exitCode=1]"
   ]
  },
  "an address loses its sign-in, its query and its fragment, and keeps what follows it": {
   "returned": [
    "https://example.com/repo.git",
    "see https://example.com/a, then (http://host:8080/p).",
    "HTTPS://Example.com/Path",
    "http://host/path",
    "https://example.com/a@b/c",
    "https://example.com",
    "https://example.com",
    "no address here, ssh://git@example.com/x.git stays",
    "two: https://x.test/1 https://y.test/2\"",
    "https://",
    "https://host/",
    ""
   ]
  },
