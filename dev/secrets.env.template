# Claidor Development Secrets
# Copy to ~/.config/claidor/secrets.env and fill in values
#
# This file is used to share secrets across multiple Git worktrees.
# Run ./dev/setup-environment to automatically merge these into server/.env

# GitHub OAuth - create app at https://github.com/settings/apps
# Or run: ./dev/setup-environment --setup-github-app
CLAIDOR_GITHUB_CLIENT_ID=
CLAIDOR_GITHUB_CLIENT_SECRET=
CLAIDOR_GITHUB_APP_WEBHOOK_SECRET=
CLAIDOR_GITHUB_APP_IDENTIFIER=
CLAIDOR_GITHUB_APP_PRIVATE_KEY=
CLAIDOR_GITHUB_APP_NAMESPACE=

# GitHub Repository Benefits App (usually same as above)
CLAIDOR_GITHUB_REPOSITORY_BENEFITS_APP_NAMESPACE=
CLAIDOR_GITHUB_REPOSITORY_BENEFITS_APP_IDENTIFIER=
CLAIDOR_GITHUB_REPOSITORY_BENEFITS_APP_PRIVATE_KEY=
CLAIDOR_GITHUB_REPOSITORY_BENEFITS_CLIENT_ID=
CLAIDOR_GITHUB_REPOSITORY_BENEFITS_CLIENT_SECRET=

# Stripe - from https://dashboard.stripe.com/test/apikeys
CLAIDOR_STRIPE_SECRET_KEY=
CLAIDOR_STRIPE_PUBLISHABLE_KEY=
CLAIDOR_STRIPE_WEBHOOK_SECRET=
CLAIDOR_STRIPE_CONNECT_WEBHOOK_SECRET=
