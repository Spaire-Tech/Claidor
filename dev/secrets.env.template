# Simeon Development Secrets
# Copy to ~/.config/simeon/secrets.env and fill in values
#
# This file is used to share secrets across multiple Git worktrees.
# Run ./dev/setup-environment to automatically merge these into server/.env

# GitHub OAuth - create app at https://github.com/settings/apps
# Or run: ./dev/setup-environment --setup-github-app
SIMEON_GITHUB_CLIENT_ID=
SIMEON_GITHUB_CLIENT_SECRET=
SIMEON_GITHUB_APP_WEBHOOK_SECRET=
SIMEON_GITHUB_APP_IDENTIFIER=
SIMEON_GITHUB_APP_PRIVATE_KEY=
SIMEON_GITHUB_APP_NAMESPACE=

# GitHub Repository Benefits App (usually same as above)
SIMEON_GITHUB_REPOSITORY_BENEFITS_APP_NAMESPACE=
SIMEON_GITHUB_REPOSITORY_BENEFITS_APP_IDENTIFIER=
SIMEON_GITHUB_REPOSITORY_BENEFITS_APP_PRIVATE_KEY=
SIMEON_GITHUB_REPOSITORY_BENEFITS_CLIENT_ID=
SIMEON_GITHUB_REPOSITORY_BENEFITS_CLIENT_SECRET=

# Stripe - from https://dashboard.stripe.com/test/apikeys
SIMEON_STRIPE_SECRET_KEY=
SIMEON_STRIPE_PUBLISHABLE_KEY=
SIMEON_STRIPE_WEBHOOK_SECRET=
SIMEON_STRIPE_CONNECT_WEBHOOK_SECRET=
