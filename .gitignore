# server/.minio/ is NOT ignored: CI, docker-compose and dev/docker all mount
# it, so ignoring it meant four consumers pointed at a directory that is never
# checked out and the Server test job could not start. Only its runtime data
# is ignored.
server/.minio/data/

# Email renderer
server/emails/.npmrc

# Docker dev environment
dev/docker/.env.docker

# Tinybird
server/.tinyb
.tinyb

# Wrangler
.wrangler/

# Redis persistence snapshot, written by the dev Redis into the working
# tree. Runtime state, recreated on every save — never source.
server/dump.rdb

# Agent worktrees (Claude Code isolation), never committed
.claude/worktrees/

# Turborepo cache when turbo runs from the repository root
.turbo/
